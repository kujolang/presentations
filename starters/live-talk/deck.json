      "features": [
        {
          "title": "Observe",
          "copy": "[What to look for.]"
        },
        {
          "title": "Choose",
          "copy": "[A decision to make.]"
        },
        {
          "title": "Try",
          "copy": "[A small experiment.]"
        },
        {
          "title": "Reflect",
          "copy": "[How to learn from the result.]"
        }
