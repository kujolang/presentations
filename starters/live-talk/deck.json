        {
          "title": "Understand",
          "copy": "[The first idea.]"
        },
        {
          "title": "Recognize",
          "copy": "[The second idea.]"
        },
        {
          "title": "Try",
          "copy": "[A practical action.]"
        }
      ]
    },
    {
      "layout": "problem",
      "title": "The familiar mistake",
      "copy": "[Describe a real tension, not an invented anecdote.]",
      "features": [
        {
          "title": "What happens",
          "copy": "[Observed behavior.]"
        },
        {
          "title": "Why it happens",
          "copy": "[The underlying cause.]"
        },
        {
          "title": "What it costs",
          "copy": "[A supported consequence.]"
        }
      ]
    },
    {
      "layout": "editorial",
      "title": "A different approach",
