:357,"utf16_col":14}},"extent_utf16":{"start":{"line_number":357,"utf16_col":0},"end":{"line_number":367,"utf16_col":0}}},{"name":"Rate limiting","fully_qualified_name":"Rate limiting","kind":"section_2","ident_start":18699,"ident_end":18712,"extent_start":18696,"extent_end":19290,"ident_utf16":{"start":{"line_number":367,"utf16_col":3},"end":{"line_number":367,"utf16_col":16}},"extent_utf16":{"start":{"line_number":367,"utf16_col":0},"end":{"line_number":374,"utf16_col":0}}},{"name":"Automated database backups","fully_qualified_name":"Automated database backups","kind":"section_2","ident_start":19293,"ident_end":19319,"extent_start":19290,"extent_end":21124,"ident_utf16":{"start":{"line_number":374,"utf16_col":3},"end":{"line_number":374,"utf16_col":29}},"extent_utf16":{"start":{"line_number":374,"utf16_col":0},"end":{"line_number":409,"utf16_col":0}}},{"name":"Integrating any OpenAI-compatible client","fully_qualified_name":"Integrating any OpenAI-compatible client","kind":"section_2","ident_start":21127,"ident_end":21167,"extent_start":21124,"extent_end":22948,"ident_utf16":{"start":{"line_number":409,"utf16_col":3},"end":{"line_number":409,"utf16_col":43}},"extent_utf16":{"start":{"line_number":409,"utf16_col":0},"end":{"line_number":460,"utf16_col":0}}},{"name":"Aggregating multiple apps and API keys","fully_qualified_name":"Aggregating multiple apps and API keys","kind":"section_3","ident_start":21714,"ident_end":21752,"extent_start":21710,"extent_end":22948,"ident_utf16":{"start":{"line_number":434,"utf16_col":4},"end":{"line_number":434,"utf16_col":42}},"extent_utf16":{"start":{"line_number":434,"utf16_col":0},"end":{"line_number":460,"utf16_col":0}}},{"name":"AI Chat integration example (no AI Chat code changes)","fully_qualified_name":"AI Chat integration example (no AI Chat code changes)","kind":"section_2","ident_start":22951,"ident_end":23004,"extent_start":22948,"extent_end":23732,"ident_utf16":{"start":{"line_number":460,"utf16_col":3},"end":{"line_number":460,"utf16_col":56}},"extent_utf16":{"start":{"line_number":460,"utf16_col":0},"end":{"line_number":480,"utf16_col":0}}},{"name":"What is logged","fully_qualified_name":"What is logged","kind":"section_2","ident_start":23735,"ident_end":23749,"extent_start":23732,"extent_end":24723,"ident_utf16":{"start":{"line_number":480,"utf16_col":3},"end":{"line_number":480,"utf16_col":17}},"extent_utf16":{"start":{"line_number":480,"utf16_col":0},"end":{"line_number":495,"utf16_col":0}}},{"name":"Watchdog API reference","fully_qualified_name":"Watchdog API reference","kind":"section_2","ident_start":24726,"ident_end":24748,"extent_start":24723,"extent_end":31848,"ident_utf16":{"start":{"line_number":495,"utf16_col":3},"end":{"line_number":495,"utf16_col":25}},"extent_utf16":{"start":{"line_number":495,"utf16_col":0},"end":{"line_number":583,"utf16_col":0}}},{"name":"Benchmark script","fully_qualified_name":"Benchmark script","kind":"section_2","ident_start":31851,"ident_end":31867,"extent_start":31848,"extent_end":32658,"ident_utf16":{"start":{"line_number":583,"utf16_col":3},"end":{"line_number":583,"utf16_col":19}},"extent_utf16":{"start":{"line_number":583,"utf16_col":0},"end":{"line_number":602,"utf16_col":0}}},{"name":"Project structure","fully_qualified_name":"Project structure","kind":"section_2","ident_start":32661,"ident_end":32678,"extent_start":32658,"extent_end":33891,"ident_utf16":{"start":{"line_number":602,"utf16_col":3},"end":{"line_number":602,"utf16_col":20}},"extent_utf16":{"start":{"line_number":602,"utf16_col":0},"end":{"line_number":628,"utf16_col":0}}},{"name":"Implementation backlog","fully_qualified_name":"Implementation backlog","kind":"section_2","ident_start":33894,"ident_end":33916,"extent_start":33891,"extent_end":35214,"ident_utf16":{"start":{"line_number":628,"utf16_col":3},"end":{"line_number":628,"utf16_col":25}},"extent_utf16":{"start":{"line_number":628,"utf16_col":0},"end":{"line_number":646,"utf16_col":0}}},{"name":"Requirements","fully_qualified_name":"Requirements","kind":"section_2","ident_start":35217,"ident_end":35229,"extent_start":35214,"extent_end":36602,"ident_utf16":{"start":{"line_number":646,"utf16_col":3},"end":{"line_number":646,"utf16_col":15}},"extent_utf16":{"start":{"line_number":646,"utf16_col":0},"end":{"line_number":674,"utf16_col":0}}},{"name":"Canonical batch intake bounds","fully_qualified_name":"Canonical batch intake bounds","kind":"section_3","ident_start":35481,"ident_end":35510,"extent_start":35477,"extent_end":36602,"ident_utf16":{"start":{"line_number":654,"utf16_col":4},"end":{"line_number":654,"utf16_col":33}},"extent_utf16":{"start":{"line_number":654,"utf16_col":0},"end":{"line_number":674,"utf16_col":0}}},{"name":"Kujo 1.6 runtime measurements","fully_qualified_name":"Kujo 1.6 runtime measurements","kind":"section_2","ident_start":36605,"ident_end":36634,"extent_start":36602,"extent_end":37343,"ident_utf16":{"start":{"line_number":674,"utf16_col":3},"end":{"line_number":674,"utf16_col":32}},"extent_utf16":{"start":{"line_number":674,"utf16_col":0},"end":{"line_number":687,"utf16_col":0}}},{"name":"Concurrent canonical intake","fully_qualified_name":"Concurrent canonical intake","kind":"section_3","ident_start":36827,"ident_end":36854,"extent_start":36823,"extent_end":37343,"ident_utf16":{"start":{"line_number":678,"utf16_col":4},"end":{"line_number":678,"utf16_col":31}},"extent_utf16":{"start":{"line_number":678,"utf16_col":0},"end":{"line_number":687,"utf16_col":0}}},{"name":"Repository verification","fully_qualified_name":"Repository verification","kind":"section_2","ident_start":37346,"ident_end":37369,"extent_start":37343,"extent_end":37999,"ident_utf16":{"start":{"line_number":687,"utf16_col":3},"end":{"line_number":687,"utf16_col":26}},"extent_utf16":{"start":{"line_number":687,"utf16_col":0},"end":{"line_number":699,"utf16_col":0}}}]}},"codeViewLayoutRoute":{"repo":{"id":1264528352,"defaultBranch":"main","name":"watchdog","ownerLogin":"kujolang","curre