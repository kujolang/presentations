  <script type="application/json" data-target="react-app.embeddedData">{"payload":{"codeViewBlobRoute":{"csv":null,"csvError":null,"headerInfo":{"toc":[{"level":1,"text":"Kujo","anchor":"kujo","htmlText":"Kujo"},{"level":2,"text":"Install","anchor":"install","htmlText":"Install"},{"level":2,"text":"Run your first program","anchor":"run-your-first-program","htmlText":"Run your first program"},{"level":2,"text":"Add packages with Kennel","anchor":"add-packages-with-kennel","htmlText":"Add packages with Kennel"},{"level":2,"text":"What Kujo includes","anchor":"what-kujo-includes","htmlText":"What Kujo includes"},{"level":2,"text":"Everyday commands","anchor":"everyday-commands","htmlText":"Everyday commands"},{"level":2,"text":"Safety Model Snapshot","anchor":"safety-model-snapshot","htmlText":"Safety Model Snapshot"},{"level":2,"text":"AI-Native Runtime Snapshot","anchor":"ai-native-runtime-snapshot","htmlText":"AI-Native Runtime Snapshot"},{"level":2,"text":"Runtime Mode Recommendations","anchor":"runtime-mode-recommendations","htmlText":"Runtime Mode Recommendations"},{"level":2,"text":"1.0 Release Status","anchor":"10-release-status","htmlText":"1.0 Release Status"},{"level":2,"text":"Build and test from source","anchor":"build-and-test-from-source","htmlText":"Build and test from source"},{"level":2,"text":"Core Reference Links","anchor":"core-reference-links","htmlText":"Core Reference Links"},{"level":2,"text":"Upgrade","anchor":"upgrade","htmlText":"Upgrade"}]},"issueTemplate":null,"discussionTemplate":null,"richText":"\u003carticle class=\"markdown-body entry-content container-lg\" itemprop=\"text\"\u003e\u003cdiv class=\"markdown-heading\" dir=\"auto\"\u003e\u003ch1 tabindex=\"-1\" class=\"heading-element\" dir=\"auto\"\u003eKujo\u003c/h1\u003e\u003ca id=\"user-content-kujo\" class=\"anchor\" aria-label=\"Permalink: Kujo\" href=\"#kujo\"\u003e\u003csvg data-component=\"Octicon\" class=\"octicon octicon-link\" viewBox=\"0 0 16 16\" version=\"1.1\" width=\"16\" height=\"16\" aria-hidden=\"true\"\u003e\u003cpath d=\"m7.775 3.275 1.25-1.25a3.5 3.5 0 1 1 4.95 4.95l-2.5 2.5a3.5 3.5 0 0 1-4.95 0 .751.751 0 0 1 .018-1.042.751.751 0 0 1 1.042-.018 1.998 1.998 0 0 0 2.83 0l2.5-2.5a2.002 2.002 0 0 0-2.83-2.83l-1.25 1.25a.751.751 0 0 1-1.042-.018.751.751 0 0 1-.018-1.042Zm-4.69 9.64a1.998 1.998 0 0 0 2.83 0l1.25-1.25a.751.751 0 0 1 1.042.018.751.751 0 0 1 .018 1.042l-1.25 1.25a3.5 3.5 0 1 1-4.95-4.95l2.5-2.5a3.5 3.5 0 0 1 4.95 0 .751.751 0 0 1-.018 1.042.751.751 0 0 1-1.042.018 1.998 1.998 0 0 0-2.83 0l-2.5 2.5a1.998 1.998 0 0 0 0 2.83Z\"\u003e\u003c/path\u003e\u003c/svg\u003e\u003c/a\u003e\u003c/div\u003e\n\u003cp dir=\"auto\"\u003e\u003ca href=\"/kujolang/kujo/blob/7a13207019a51e61d3db448bc13f59d5b0e332e5/docs/RELEASE_NOTES_1_9_0.md\"\u003e\u003cimg src=\"https://camo.githubusercontent.com/eef827da61bfe2d7df67121e2f5f6fd28cd05d67529fd778e279a32d35ed3cdb/68747470733a2f2f696d672e736869656c64732e696f2f62616467652f76657273696f6e2d312e392e302d626c61636b\" alt=\"Version\" data-canonical-src=\"https://img.shields.io/badge/version-1.9.0-black\" style=\"max-width: 100%;\"\u003e\u003c/a\u003e\n\u003ca href=\"/kujolang/kujo/blob/7a13207019a51e61d3db448bc13f59d5b0e332e5/LICENSE\"\u003e\u003cimg src=\"https://camo.githubusercontent.com/be07a68b57a673af622198c336264f89d82bf4cd5d87bc0cb3f7b6ae47cc43ea/68747470733a2f2f696d672e736869656c64732e696f2f62616467652f6c6963656e73652d4d49542d6c6967687467726579\" alt=\"License\" data-canonical-src=\"https://img.shields.io/badge/license-MIT-lightgrey\" style=\"max-width: 100%;\"\u003e\u003c/a\u003e\n\u003ca href=\"https://www.rust-lang.org/\" rel=\"nofollow\"\u003e\u003cimg src=\"https://camo.githubusercontent.com/b5d1c74251c7703f509a7b96cf978e176647240ac15913144489c76258416ccf/68747470733a2f2f696d672e736869656c64732e696f2f62616467652f6275696c74253230776974682d527573742d77686974652e737667\" alt=\"built with Rust\" data-canonical-src=\"https://img.shields.io/badge/built%20with-Rust-white.svg\" style=\"max-width: 100%;\"\u003e\u003c/a\u003e\u003c/p\u003e\n\u003cp dir=\"auto\"\u003eKujo is a programming language for local-first automation, AI-native software,\nand practical application scripting. The runtime is written in Rust. \u003ccode\u003ekujo run\u003c/code\u003e\nuses the bytecode VM by default; a tree-walking interpreter remains available for\ncompatibility and debugging.\u003c/p\u003e\n\u003cdiv class=\"markdown-heading\" dir=\"auto\"\u003e\u003ch2 tabindex=\"-1\" class=\"heading-element\" dir=\"auto\"\u003eInstall\u003c/h2\u003e\u003ca id=\"user-content-install\" class=\"anchor\" aria-label=\"Permalink: Install\" href=\"#install\"\u003e\u003csvg data-component=\"Octicon\" class=\"octicon octicon-link\" viewBox=\"0 0 16 16\" version=\"1.1\" width=\"16\" height=\"16\" aria-hidden=\"true\"\u003e\u003cpath d=\"m7.775 3.275 1.25-1.25a3.5 3.5 0 1 1 4.95 4.95l-2.5 2.5a3.5 3.5 0 0 1-4.95 0 .751.751 0 0 1 .018-1.042.751.751 0 0 1 1.042-.018 1.998 1.998 0 0 0 2.83 0l2.5-2.5a2.002 2.002 0 0 0-2.83-2.83l-1.25 1.25a.751.751 0 0 1-1.042-.018.751.751 0 0 1-.018-1.042Zm-4.69 9.64a1.998 1.998 0 0 0 2.83 0l1.25-1.25a.751.751 0 0 1 1.042.018.751.751 0 0 1 .018 1.042l-1.25 1.25a3.5 3.5 0 1 1-4.95-4.95l2.5-2.5a3.5 3.5 0 0 1 4.95 0 .751.751 0 0 1-.018 1.042.751.751 0 0 1-1.042.018 1.998 1.998 0 0 0-2.83 0l-2.5 2.5a1.998 1.998 0 0 0 0 2.83Z\"\u003e\u003c/path\u003e\u003c/svg\u003e\u003c/a\u003e\u003c/div\u003e\n\u003cp dir=\"auto\"\u003eOn macOS or Linux, the Kujo installer sets up the current runtime and the core\nKujo toolset in user-owned directories:\u003c/p\u003e\n\u003cdiv class=\"highlight highlight-source-shell notranslate position-relative overflow-auto\" dir=\"auto\" data-snippet-clipboard-copy-content=\"curl -fsSL https://kujolang.ai/install.sh | KUJO_RELEASE_VERSION=v1.9.0 bash\nexport PATH=\u0026quot;$HOME/.local/bin:$PATH\u0026quot;\nkujo --version\"\u003e\u003cpre\u003ecurl -fsSL https://kujolang.ai/install.sh \u003cspan class=\"pl-k\"\u003e|\u003c/span\u003e KUJO_RELEASE_VERSION=v1.9.0 bash\n\u003cspan class=\"pl-k\"\u003eexport\u003c/span\u003e PATH=\u003cspan class=\"pl-s\"\u003e\u003cspan class=\"pl-pds\"\u003e\"\u003c/span\u003e\u003cspan class=\"pl-smi\"\u003e$HOME\u003c/span\u003e/.local/bin:\u003cspan class=\"pl-smi\"\u003e$PATH\u003c/span\u003e\u003cspan class=\"pl-pds\"\u003e\"\u003c/span\u003e\u003c/span\u003e\nkujo --version\u003c/pre\u003e\u003c/div\u003e\n\u003cp dir=\"auto\"\u003eThe default install includes Kujo, Kennel, and the core tools used for packages,\ntask specs, context, tests, and run records. See \u003ca href=\"/kujolang/kujo/blob/7a13207019a51e61d3db448bc13f59d5b0e332e5/INSTALLATION.md\"\u003eInstallation\u003c/a\u003e\nfor a runtime-only npm install, Windows steps, source builds, profiles, updates,\nand uninstall instructions.\u003c/p\u003e\n\u003cp dir=\"auto\"\u003eConcurrency behavior and validation for the current development branch are\nrecorded in \u003ca href=\"/kujolang/kujo/blob/7a13207019a51e61d3db448bc13f59d5b0e332e5/docs/RUNTIME_CONCURRENCY_COMPLETION.md\"\u003ethe runtime completion record\u003c/a\u003e.\nAsync tasks are bounded, generator aliases share progress, and detached work has\nno implicit process-exit join.\u003c/p\u003e\n\u003cdiv class=\"markdown-heading\" dir=\"auto\"\u003e\u003ch2 tabindex=\"-1\" class=\"heading-element\" dir=\"auto\"\u003eRun your first program\u003c/h2\u003e\u003ca id=\"user-content-run-your-first-program\" class=\"anchor\" aria-label=\"Permalink: Run your first program\" href=\"#run-your-first-program\"\u003e\u003csvg data-component=\"Octicon\" class=\"octicon octicon-link\" viewBox=\"0 0 16 16\" version=\"1.1\" width=\"16\" height=\"16\" aria-hidden=\"true\"\u003e\u003cpath d=\"m7.775 3.275 1.25-1.25a3.5 3.5 0 1 1 4.95 4.95l-2.5 2.5a3.5 3.5 0 0 1-4.95 0 .751.751 0 0 1 .018-1.042.751.751 0 0 1 1.042-.018 1.998 1.998 0 0 0 2.83 0l2.5-2.5a2.002 2.002 0 0 0-2.83-2.83l-1.25 1.25a.751.751 0 0 1-1.042-.018.751.751 0 0 1-.018-1.042Zm-4.69 9.64a1.998 1.998 0 0 0 2.83 0l1.25-1.25a.751.751 0 0 1 1.042.018.751.751 0 0 1 .018 1.042l-1.25 1.25a3.5 3.5 0 1 1-4.95-4.95l2.5-2.5a3.5 3.5 0 0 1 4.95 0 .751.751 0 0 1-.018 1.042.751.751 0 0 1-1.042.018 1.998 1.998 0 0 0-2.83 0l-2.5 2.5a1.998 1.998 0 0 0 0 2.83Z\"\u003e\u003c/path\u003e\u003c/svg\u003e\u003c/a\u003e\u003c/div\u003e\n\u003cp dir=\"auto\"\u003eCreate \u003ccode\u003ehello.kujo\u003c/code\u003e:\u003c/p\u003e\n\u003cdiv class=\"snippet-clipboard-content notranslate position-relative overflow-auto\" data-snippet-clipboard-copy-content=\"func greet(name) {\n    print(\u0026quot;Hello, \u0026quot; + name + \u0026quot;!\u0026quot;)\n}\n\ngreet(\u0026quot;Kujo\u0026quot;)\"\u003e\u003cpre lang=\"kujo\" class=\"notranslate\"\u003e\u003ccode\u003efunc greet(name) {\n    print(\"Hello, \" + name + \"!\")\n}\n\ngreet(\"Kujo\")\n\u003c/code\u003e\u003c/pre\u003e\u003c/div\u003e\n\u003cp dir=\"auto\"\u003eThen check and run it:\u003c/p\u003e\n\u003cdiv class=\"highlight highlight-source-shell notranslate position-relative overflow-auto\" dir=\"auto\" data-snippet-clipboard-copy-content=\"kujo check hello.kujo\nkujo run hello.kujo\"\u003e\u003cpre\u003ekujo check hello.kujo\nkujo run hello.kujo\u003c/pre\u003e\u003c/div\u003e\n\u003cdiv class=\"markdown-heading\" dir=\"auto\"\u003e\u003ch2 tabindex=\"-1\" class=\"heading-element\" dir=\"auto\"\u003eAdd packages with Kennel\u003c/h2\u003e\u003ca id=\"user-content-add-packages-with-kennel\" class=\"anchor\" aria-label=\"Permalink: Add packages with Kennel\" href=\"#add-packages-with-kennel\"\u003e\u003csvg data-component=\"Octicon\" class=\"octicon octicon-link\" viewBox=\"0 0 16 16\" version=\"1.1\" width=\"16\" height=\"16\" aria-hidden=\"true\"\u003e\u003cpath d=\"m7.775 3.275 1.25-1.25a3.5 3.5 0 1 1 4.95 4.95l-2.5 2.5a3.5 3.5 0 0 1-4.95 0 .751.751 0 0 1 .018-1.042.751.751 0 0 1 1.042-.018 1.998 1.998 0 0 0 2.83 0l2.5-2.5a2.002 2.002 0 0 0-2.83-2.83l-1.25 1.25a.751.751 0 0 1-1.042-.018.751.751 0 0 1-.018-1.042Zm-4.69 9.64a1.998 1.998 0 0 0 2.83 0l1.25-1.25a.751.751 0 0 1 1.042.018.751.751 0 0 1 .018 1.042l-1.25 1.25a3.5 3.5 0 1 1-4.95-4.95l2.5-2.5a3.5 3.5 0 0 1 4.95 0 .751.751 0 0 1-.018 1.042.751.751 0 0 1-1.042.018 1.998 1.998 0 0 0-2.83 0l-2.5 2.5a1.998 1.998 0 0 0 0 2.83Z\"\u003e\u003c/path\u003e\u003c/svg\u003e\u003c/a\u003e\u003c/div\u003e\n\u003cp dir=\"auto\"\u003e\u003ca href=\"https://kennel.kujolang.ai/\" rel=\"nofollow\"\u003eKennel\u003c/a\u003e is Kujo's package manager and official\npackage registry. Public package reads need no account. Install the current\nKennel client on macOS or Linux after installing Kujo 1.4.0 or newer:\u003c/p\u003e\n\u003cdiv class=\"highlight highlight-source-shell notranslate position-relative overflow-auto\" dir=\"auto\" data-snippet-clipboard-copy-content=\"curl -fsSLO https://kennel.kujolang.ai/install.sh\nsh install.sh\n. \u0026quot;$HOME/.kennel/env\u0026quot;\nkennel --version\"\u003e\u003cpre\u003ecurl -fsSLO https://kennel.kujolang.ai/install.sh\nsh install.sh\n\u003cspan class=\"pl-c1\"\u003e.\u003c/span\u003e \u003cspan class=\"pl-s\"\u003e\u003cspan class=\"pl-pds\"\u003e\"\u003c/span\u003e\u003cspan class=\"pl-smi\"\u003e$HOME\u003c/span\u003e/.kennel/env\u003cspan class=\"pl-pds\"\u003e\"\u003c/span\u003e\u003c/span\u003e\nkennel --version\u003c/pre\u003e\u003c/div\u003e\n\u003cp dir=\"auto\"\u003eAdd a project dependency:\u003c/p\u003e\n\u003cdiv class=\"highlight highlight-source-shell notranslate position-relative overflow-auto\" dir=\"auto\" data-snippet-clipboard-copy-content=\"kennel init --name my-project\nkennel add ability\nkennel install\"\u003e\u003cpre\u003ekennel init --name my-project\nkennel add ability\nkennel install\u003c/pre\u003e\u003c/div\u003e\n\u003cp dir=\"auto\"\u003eOr install a command you can use from any directory:\u003c/p\u003e\n\u003cdiv class=\"highlight highlight-source-shell notranslate position-relative overflow-auto\" dir=\"auto\" data-snippet-clipboard-copy-content=\"kennel tool install shipcheck\nshipcheck --help\"\u003e\u003cpre\u003ekennel tool install shipcheck\nshipcheck --help\u003c/pre\u003e\u003c/div\u003e\n\u003cp dir=\"auto\"\u003eKennel writes \u003ccode\u003ekennel.toml\u003c/code\u003e and \u003ccode\u003ekennel.lock\u003c/code\u003e. Kujo also has a smaller built-in\n\u003ccode\u003ekujo.toml\u003c/code\u003e / \u003ccode\u003ekujo.lock\u003c/code\u003e workflow. The formats serve different jobs and are not\ninterchangeable. Read \u003ca href=\"https://docs.kujolang.ai/learn/packages/\" rel=\"nofollow\"\u003ePackages with Kennel\u003c/a\u003e\nbefore choosing one.\u003c/p\u003e\n\u003cdiv class=\"markdown-heading\" dir=\"auto\"\u003e\u003ch2 tabindex=\"-1\" class=\"heading-element\" dir=\"auto\"\u003eWhat Kujo includes\u003c/h2\u003e\u003ca id=\"user-content-what-kujo-includes\" class=\"anchor\" aria-label=\"Permalink: What Kujo includes\" href=\"#what-kujo-includes\"\u003e\u003csvg data-component=\"Octicon\" class=\"octicon octicon-link\" viewBox=\"0 0 16 16\" version=\"1.1\" width=\"16\" height=\"16\" aria-hidden=\"true\"\u003e\u003cpath d=\"m7.775 3.275 1.25-1.25a3.5 3.5 0 1 1 4.95 4.95l-2.5 2.5a3.5 3.5 0 0 1-4.95 0 .751.751 0 0 1 .018-1.042.751.751 0 0 1 1.042-.018 1.998 1.998 0 0 0 2.83 0l2.5-2.5a2.002 2.002 0 0 0-2.83-2.83l-1.25 1.25a.751.751 0 0 1-1.042-.018.751.751 0 0 1-.018-1.042Zm-4.69 9.64a1.998 1.998 0 0 0 2.83 0l1.25-1.25a.751.751 0 0 1 1.042.018.751.751 0 0 1 .018 1.042l-1.25 1.25a3.5 3.5 0 1 1-4.95-4.95l2.5-2.5a3.5 3.5 0 0 1 4.95 0 .751.751 0 0 1-.018 1.042.751.751 0 0 1-1.042.018 1.998 1.998 0 0 0-2.83 0l-2.5 2.5a1.998 1.998 0 0 0 0 2.83Z\"\u003e\u003c/path\u003e\u003c/svg\u003e\u003c/a\u003e\u003c/div\u003e\n\u003cul dir=\"auto\"\u003e\n\u003cli\u003eA VM-first runtime with functions, modules, collections, structs, enums,\npattern matching, exceptions, async work, and generator support with documented\nVM/interpreter limits.\u003c/li\u003e\n\u003cli\u003eNative filesystem, process, network, HTTP, crypto, database, and data helpers.\u003c/li\u003e\n\u003cli\u003eDeterministic AI request hashes, record/replay cassettes, streaming callbacks,\nmultimodal messages, token estimates, secret redaction, JSON Schema validation,\nand vector math.\u003c/li\u003e\n\u003cli\u003eA formatter, linter, test runner, LSP, documentation generator, static server,\nbenchmarks, diagnostics, and stable machine-readable output contracts.\u003c/li\u003e\n\u003cli\u003eCapability controls for scripts that should not receive ambient host access.\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp dir=\"auto\"\u003eCore AI-native runtime mechanisms are implemented for deterministic request hashing, offline record/replay cassettes, structured response metadata, JSON Schema validation, vector math, token budgeting, runtime secret redaction, dedicated AI egress capability controls, streaming callbacks, and multimodal message builders.\u003c/p\u003e\n\u003cp dir=\"auto\"\u003eDotted module import workflows are supported on the default VM path. Package\nworkflows are deterministic: \u003ccode\u003ekujo init\u003c/code\u003e, \u003ccode\u003ekujo package-add\u003c/code\u003e, \u003ccode\u003ekujo package-install\u003c/code\u003e, and \u003ccode\u003ekujo package-install --frozen\u003c/code\u003e work with nested source layouts and reproducible \u003ccode\u003ekujo.lock\u003c/code\u003e snapshots.\u003c/p\u003e\n\u003cdiv class=\"markdown-heading\" dir=\"auto\"\u003e\u003ch2 tabindex=\"-1\" class=\"heading-element\" dir=\"auto\"\u003eEveryday commands\u003c/h2\u003e\u003ca id=\"user-content-everyday-commands\" class=\"anchor\" aria-label=\"Permalink: Everyday commands\" href=\"#everyday-commands\"\u003e\u003csvg data-component=\"Octicon\" class=\"octicon octicon-link\" viewBox=\"0 0 16 16\" version=\"1.1\" width=\"16\" height=\"16\" aria-hidden=\"true\"\u003e\u003cpath d=\"m7.775 3.275 1.25-1.25a3.5 3.5 0 1 1 4.95 4.95l-2.5 2.5a3.5 3.5 0 0 1-4.95 0 .751.751 0 0 1 .018-1.042.751.751 0 0 1 1.042-.018 1.998 1.998 0 0 0 2.83 0l2.5-2.5a2.002 2.002 0 0 0-2.83-2.83l-1.25 1.25a.751.751 0 0 1-1.042-.018.751.751 0 0 1-.018-1.042Zm-4.69 9.64a1.998 1.998 0 0 0 2.83 0l1.25-1.25a.751.751 0 0 1 1.042.018.751.751 0 0 1 .018 1.042l-1.25 1.25a3.5 3.5 0 1 1-4.95-4.95l2.5-2.5a3.5 3.5 0 0 1 4.95 0 .751.751 0 0 1-.018 1.042.751.751 0 0 1-1.042.018 1.998 1.998 0 0 0-2.83 0l-2.5 2.5a1.998 1.998 0 0 0 0 2.83Z\"\u003e\u003c/path\u003e\u003c/svg\u003e\u003c/a\u003e\u003c/div\u003e\n\u003cdiv class=\"highlight highlight-source-shell notranslate position-relative overflow-auto\" dir=\"auto\" data-snippet-clipboard-copy-content=\"kujo run app.kujo                 # run on the VM\nkujo check app.kujo               # validate without running\nkujo format --write app.kujo      # format in place\nkujo lint app.kujo                # find common problems\nkujo test                         # run snapshot fixtures\nkujo test-run tests.kujo          # run test declarations\nkujo doctor --json                # inspect the environment\nkujo mcp make [dir]               # generate a repo-specific MCP server\nkujo serve [dir]                  # preview a static directory\nkujo lsp                          # start the language server\"\u003e\u003cpre\u003ekujo run app.kujo                 \u003cspan class=\"pl-c\"\u003e\u003cspan class=\"pl-c\"\u003e#\u003c/span\u003e run on the VM\u003c/span\u003e\nkujo check app.kujo               \u003cspan class=\"pl-c\"\u003e\u003cspan class=\"pl-c\"\u003e#\u003c/span\u003e validate without running\u003c/span\u003e\nkujo format --write app.kujo      \u003cspan class=\"pl-c\"\u003e\u003cspan class=\"pl-c\"\u003e#\u003c/span\u003e format in place\u003c/span\u003e\nkujo lint app.kujo                \u003cspan class=\"pl-c\"\u003e\u003cspan class=\"pl-c\"\u003e#\u003c/span\u003e find common problems\u003c/span\u003e\nkujo \u003cspan class=\"pl-c1\"\u003etest\u003c/span\u003e                         \u003cspan class=\"pl-c\"\u003e\u003cspan class=\"pl-c\"\u003e#\u003c/span\u003e run snapshot fixtures\u003c/span\u003e\nkujo test-run tests.kujo          \u003cspan class=\"pl-c\"\u003e\u003cspan class=\"pl-c\"\u003e#\u003c/span\u003e run test declarations\u003c/span\u003e\nkujo doctor --json                \u003cspan class=\"pl-c\"\u003e\u003cspan class=\"pl-c\"\u003e#\u003c/span\u003e inspect the environment\u003c/span\u003e\nkujo mcp make [dir]               \u003cspan class=\"pl-c\"\u003e\u003cspan class=\"pl-c\"\u003e#\u003c/span\u003e generate a repo-specific MCP server\u003c/span\u003e\nkujo serve [dir]                  \u003cspan class=\"pl-c\"\u003e\u003cspan class=\"pl-c\"\u003e#\u003c/span\u003e preview a static directory\u003c/span\u003e\nkujo lsp                          \u003cspan class=\"pl-c\"\u003e\u003cspan class=\"pl-c\"\u003e#\u003c/span\u003e start the language server\u003c/span\u003e\u003c/pre\u003e\u003c/div\u003e\n\u003cp dir=\"auto\"\u003eUse \u003ccode\u003e--\u003c/code\u003e before script arguments that could be mistaken for Kujo options:\u003c/p\u003e\n\u003cdiv class=\"highlight highlight-source-shell notranslate position-relative overflow-auto\" dir=\"auto\" data-snippet-clipboard-copy-content=\"kujo run tool.kujo -- --help\"\u003e\u003cpre\u003ekujo run tool.kujo -- --help\u003c/pre\u003e\u003c/div\u003e\n\u003cdiv class=\"markdown-heading\" dir=\"auto\"\u003e\u003ch2 tabindex=\"-1\" class=\"heading-element\" dir=\"auto\"\u003eSafety Model Snapshot\u003c/h2\u003e\u003ca id=\"user-content-safety-model-snapshot\" class=\"anchor\" aria-label=\"Permalink: Safety Model Snapshot\" href=\"#safety-model-snapshot\"\u003e\u003csvg data-component=\"Octicon\" class=\"octicon octicon-link\" viewBox=\"0 0 16 16\" version=\"1.1\" width=\"16\" height=\"16\" aria-hidden=\"true\"\u003e\u003cpath d=\"m7.775 3.275 1.25-1.25a3.5 3.5 0 1 1 4.95 4.95l-2.5 2.5a3.5 3.5 0 0 1-4.95 0 .751.751 0 0 1 .018-1.042.751.751 0 0 1 1.042-.018 1.998 1.998 0 0 0 2.83 0l2.5-2.5a2.002 2.002 0 0 0-2.83-2.83l-1.25 1.25a.751.751 0 0 1-1.042-.018.751.751 0 0 1-.018-1.042Zm-4.69 9.64a1.998 1.998 0 0 0 2.83 0l1.25-1.25a.751.751 0 0 1 1.042.018.751.751 0 0 1 .018 1.042l-1.25 1.25a3.5 3.5 0 1 1-4.95-4.95l2.5-2.5a3.5 3.5 0 0 1 4.95 0 .751.751 0 0 1-.018 1.042.751.751 0 0 1-1.042.018 1.998 1.998 0 0 0-2.83 0l-2.5 2.5a1.998 1.998 0 0 0 0 2.83Z\"\u003e\u003c/path\u003e\u003c/svg\u003e\u003c/a\u003e\u003c/div\u003e\n\u003cp dir=\"auto\"\u003eKujo is not a sandbox. A normal \u003ccode\u003ekujo run\u003c/code\u003e is trusted and can use host-effect\nAPIs. For code you do not trust, start with \u003ccode\u003e--untrusted\u003c/code\u003e and grant only the\ncapabilities it needs:\u003c/p\u003e\n\u003cdiv class=\"highlight highlight-source-shell notranslate position-relative overflow-auto\" dir=\"auto\" data-snippet-clipboard-copy-content=\"kujo run --untrusted --allow-fs-read report.kujo\nkujo run --untrusted --allow-ai agent.kujo\"\u003e\u003cpre\u003ekujo run --untrusted --allow-fs-read report.kujo\nkujo run --untrusted --allow-ai agent.kujo\u003c/pre\u003e\u003c/div\u003e\n\u003cp dir=\"auto\"\u003eUse \u003ccode\u003e--deny-private-net\u003c/code\u003e when network clients must reject local, private,\nlink-local, multicast, and unspecified destinations. For AI-only access, prefer\n\u003ccode\u003e--allow-ai\u003c/code\u003e to broad network access and set \u003ccode\u003eKUJO_AI_ALLOWED_ENDPOINTS\u003c/code\u003e to the\nprovider URLs the script may call.\u003c/p\u003e\n\u003cp dir=\"auto\"\u003eRead \u003ca href=\"/kujolang/kujo/blob/7a13207019a51e61d3db448bc13f59d5b0e332e5/docs/SECURE_AI_SCRIPTING.md\"\u003eSecure AI scripting\u003c/a\u003e and the\n\u003ca href=\"/kujolang/kujo/blob/7a13207019a51e61d3db448bc13f59d5b0e332e5/docs/NATIVE_API_SECURITY_POSTURE.md\"\u003enative API security posture\u003c/a\u003e before running\nuntrusted code on a shared or sensitive machine.\u003c/p\u003e\n\u003cdiv class=\"markdown-heading\" dir=\"auto\"\u003e\u003ch2 tabindex=\"-1\" class=\"heading-element\" dir=\"auto\"\u003eAI-Native Runtime Snapshot\u003c/h2\u003e\u003ca id=\"user-content-ai-native-runtime-snapshot\" class=\"anchor\" aria-label=\"Permalink: AI-Native Runtime Snapshot\" href=\"#ai-native-runtime-snapshot\"\u003e\u003csvg data-component=\"Octicon\" class=\"octicon octicon-link\" viewBox=\"0 0 16 16\" version=\"1.1\" width=\"16\" height=\"16\" aria-hidden=\"true\"\u003e\u003cpath d=\"m7.775 3.275 1.25-1.25a3.5 3.5 0 1 1 4.95 4.95l-2.5 2.5a3.5 3.5 0 0 1-4.95 0 .751.751 0 0 1 .018-1.042.751.751 0 0 1 1.042-.018 1.998 1.998 0 0 0 2.83 0l2.5-2.5a2.002 2.002 0 0 0-2.83-2.83l-1.25 1.25a.751.751 0 0 1-1.042-.018.751.751 0 0 1-.018-1.042Zm-4.69 9.64a1.998 1.998 0 0 0 2.83 0l1.25-1.25a.751.751 0 0 1 1.042.018.751.751 0 0 1 .018 1.042l-1.25 1.25a3.5 3.5 0 1 1-4.95-4.95l2.5-2.5a3.5 3.5 0 0 1 4.95 0 .751.751 0 0 1-.018 1.042.751.751 0 0 1-1.042.018 1.998 1.998 0 0 0-2.83 0l-2.5 2.5a1.998 1.998 0 0 0 0 2.83Z\"\u003e\u003c/path\u003e\u003c/svg\u003e\u003c/a\u003e\u003c/div\u003e\n\u003cp dir=\"auto\"\u003eKujo keeps deterministic mechanisms in the runtime and leaves provider routing,\nRAG policy, agent frameworks, and observability to packages.\u003c/p\u003e\n\u003cul dir=\"auto\"\u003e\n\u003cli\u003e\u003ccode\u003eai_chat\u003c/code\u003e, \u003ccode\u003eai_stream_chat\u003c/code\u003e, \u003ccode\u003eai_embedding\u003c/code\u003e, and \u003ccode\u003eai_tool_loop\u003c/code\u003e share replay,\nresponse, and error contracts.\u003c/li\u003e\n\u003cli\u003e\u003ccode\u003eai_request_hash\u003c/code\u003e creates credential-free cache and cassette keys.\u003c/li\u003e\n\u003cli\u003e\u003ccode\u003eai_text\u003c/code\u003e, \u003ccode\u003eai_image_url\u003c/code\u003e, and \u003ccode\u003eai_message\u003c/code\u003e build portable messages.\u003c/li\u003e\n\u003cli\u003e\u003ccode\u003eai_count_tokens\u003c/code\u003e and \u003ccode\u003eai_fit_context\u003c/code\u003e provide deterministic estimates.\u003c/li\u003e\n\u003cli\u003e\u003ccode\u003esecret\u003c/code\u003e, \u003ccode\u003ereveal\u003c/code\u003e, and \u003ccode\u003eis_secret\u003c/code\u003e keep values redacted until code reveals them.\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp dir=\"auto\"\u003eRun the replay example without live provider credentials:\u003c/p\u003e\n\u003cdiv class=\"highlight highlight-source-shell notranslate position-relative overflow-auto\" dir=\"auto\" data-snippet-clipboard-copy-content=\"KUJO_AI_REPLAY=tests/fixtures/ai_cassettes \\\nKUJO_AI_REPLAY_MODE=strict \\\ncargo run -- run examples/ai_enterprise_replay_showcase.kujo\"\u003e\u003cpre\u003eKUJO_AI_REPLAY=tests/fixtures/ai_cassettes \\\nKUJO_AI_REPLAY_MODE=strict \\\ncargo run -- run examples/ai_enterprise_replay_showcase.kujo\u003c/pre\u003e\u003c/div\u003e\n\u003cp dir=\"auto\"\u003eThe short and full verification commands are:\u003c/p\u003e\n\u003cdiv class=\"highlight highlight-source-shell notranslate position-relative overflow-auto\" dir=\"auto\" data-snippet-clipboard-copy-content=\"bash scripts/enterprise_verify.sh --minimal\nbash scripts/enterprise_verify.sh --full\"\u003e\u003cpre\u003ebash scripts/enterprise_verify.sh --minimal\nbash scripts/enterprise_verify.sh --full\u003c/pre\u003e\u003c/div\u003e\n\u003cp dir=\"auto\"\u003eSee \u003ca href=\"/kujolang/kujo/blob/7a13207019a51e61d3db448bc13f59d5b0e332e5/docs/AI_RUNTIME.md\"\u003eAI runtime\u003c/a\u003e and the\n\u003ca href=\"/kujolang/kujo/blob/7a13207019a51e61d3db448bc13f59d5b0e332e5/docs/STANDARD_LIBRARY.md\"\u003estandard library\u003c/a\u003e for the complete contracts.\u003c/p\u003e\n\u003cdiv class=\"markdown-heading\" dir=\"auto\"\u003e\u003ch2 tabindex=\"-1\" class=\"heading-element\" dir=\"auto\"\u003eRuntime Mode Recommendations\u003c/h2\u003e\u003ca id=\"user-content-runtime-mode-recommendations\" class=\"anchor\" aria-label=\"Permalink: Runtime Mode Recommendations\" href=\"#runtime-mode-recommendations\"\u003e\u003csvg data-component=\"Octicon\" class=\"octicon octicon-link\" viewBox=\"0 0 16 16\" version=\"1.1\" width=\"16\" height=\"16\" aria-hidden=\"true\"\u003e\u003cpath d=\"m7.775 3.275 1.25-1.25a3.5 3.5 0 1 1 4.95 4.95l-2.5 2.5a3.5 3.5 0 0 1-4.95 0 .751.751 0 0 1 .018-1.042.751.751 0 0 1 1.042-.018 1.998 1.998 0 0 0 2.83 0l2.5-2.5a2.002 2.002 0 0 0-2.83-2.83l-1.25 1.25a.751.751 0 0 1-1.042-.018.751.751 0 0 1-.018-1.042Zm-4.69 9.64a1.998 1.998 0 0 0 2.83 0l1.25-1.25a.751.751 0 0 1 1.042.018.751.751 0 0 1 .018 1.042l-1.25 1.25a3.5 3.5 0 1 1-4.95-4.95l2.5-2.5a3.5 3.5 0 0 1 4.95 0 .751.751 0 0 1-.018 1.042.751.751 0 0 1-1.042.018 1.998 1.998 0 0 0-2.83 0l-2.5 2.5a1.998 1.998 0 0 0 0 2.83Z\"\u003e\u003c/path\u003e\u003c/svg\u003e\u003c/a\u003e\u003c/div\u003e\n\u003cul dir=\"auto\"\u003e\n\u003cli\u003eUse \u003ccode\u003ekujo run \u0026lt;file\u0026gt;\u003c/code\u003e for normal work. Developers should not need \u003ccode\u003e--interpreter\u003c/code\u003e for ordinary modular project layouts.\u003c/li\u003e\n\u003cli\u003eUse \u003ccode\u003e--interpreter\u003c/code\u003e to isolate a compatibility or runtime-path problem.\u003c/li\u003e\n\u003cli\u003eTreat \u003ccode\u003e--jit\u003c/code\u003e as experimental. Unsupported bytecode falls back to the VM.\u003c/li\u003e\n\u003cli\u003eUse \u003ccode\u003ekujo package-install --frozen\u003c/code\u003e to check \u003ccode\u003ekujo.toml\u003c/code\u003e and \u003ccode\u003ekujo.lock\u003c/code\u003e\nwithout changing either file.\u003c/li\u003e\n\u003cli\u003e\u003ccode\u003ekujo package-publish\u003c/code\u003e: preview package publish metadata only. It does not\npublish to Kennel. Kennel owns registry installation and distribution.\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp dir=\"auto\"\u003eSee the \u003ca href=\"/kujolang/kujo/blob/7a13207019a51e61d3db448bc13f59d5b0e332e5/docs/VM_INTERPRETER_MIGRATION_PLAYBOOK.md\"\u003eVM/interpreter migration playbook\u003c/a\u003e.\u003c/p\u003e\n\u003cdiv class=\"markdown-heading\" dir=\"auto\"\u003e\u003ch2 tabindex=\"-1\" class=\"heading-element\" dir=\"auto\"\u003e1.0 Release Status\u003c/h2\u003e\u003ca id=\"user-content-10-release-status\" class=\"anchor\" aria-label=\"Permalink: 1.0 Release Status\" href=\"#10-release-status\"\u003e\u003csvg data-component=\"Octicon\" class=\"octicon octicon-link\" viewBox=\"0 0 16 16\" version=\"1.1\" width=\"16\" height=\"16\" aria-hidden=\"true\"\u003e\u003cpath d=\"m7.775 3.275 1.25-1.25a3.5 3.5 0 1 1 4.95 4.95l-2.5 2.5a3.5 3.5 0 0 1-4.95 0 .751.751 0 0 1 .018-1.042.751.751 0 0 1 1.042-.018 1.998 1.998 0 0 0 2.83 0l2.5-2.5a2.002 2.002 0 0 0-2.83-2.83l-1.25 1.25a.751.751 0 0 1-1.042-.018.751.751 0 0 1-.018-1.042Zm-4.69 9.64a1.998 1.998 0 0 0 2.83 0l1.25-1.25a.751.751 0 0 1 1.042.018.751.751 0 0 1 .018 1.042l-1.25 1.25a3.5 3.5 0 1 1-4.95-4.95l2.5-2.5a3.5 3.5 0 0 1 4.95 0 .751.751 0 0 1-.018 1.042.751.751 0 0 1-1.042.018 1.998 1.998 0 0 0-2.83 0l-2.5 2.5a1.998 1.998 0 0 0 0 2.83Z\"\u003e\u003c/path\u003e\u003c/svg\u003e\u003c/a\u003e\u003c/div\u003e\n\u003cp dir=\"auto\"\u003eRelease boundary: Kujo \u003ccode\u003ev1.9.0\u003c/code\u003e is the current stable release; explicit deferrals and compatibility guarantees are governed by \u003ccode\u003edocs/V1_SCOPE.md\u003c/code\u003e.\u003c/p\u003e\n\u003cul dir=\"auto\"\u003e\n\u003cli\u003eKujo 1.9.0 is released for Linux x64/arm64, macOS x64/arm64 and Windows x64; see \u003ca href=\"/kujolang/kujo/blob/7a13207019a51e61d3db448bc13f59d5b0e332e5/docs/RELEASE_NOTES_1_9_0.md\"\u003erelease notes\u003c/a\u003e.\u003c/li\u003e\n\u003cli\u003eThe source tree is currently at \u003ccode\u003e1.9.0\u003c/code\u003e in \u003ccode\u003eCargo.toml\u003c/code\u003e; the latest published stable release tag is \u003ccode\u003ev1.9.0\u003c/code\u003e.\u003c/li\u003e\n\u003cli\u003eThe signed release, native/source archives, checksums, and all six npm packages\npassed their published-install verification matrices.\u003c/li\u003e\n\u003cli\u003ePrebuilt Linux x64/arm64, macOS x64/arm64, and Windows x64 binaries ship with\nSHA-256 checksums.\u003c/li\u003e\n\u003cli\u003eKujo v1.0 package scope was local manifest and lockfile determinism only; it\ndid not include a public Kennel registry or package publish transport. That\ndescribes the historical 1.0 runtime boundary. The separate Kennel registry is\nnow live at \u003ca href=\"https://kennel.kujolang.ai/\" rel=\"nofollow\"\u003ekennel.kujolang.ai\u003c/a\u003e.\u003c/li\u003e\n\u003cli\u003eThe v1.0 launch record remains in\n\u003ca href=\"/kujolang/kujo/blob/7a13207019a51e61d3db448bc13f59d5b0e332e5/docs/V1_0_OFFICIAL_RELEASE_CHECKLIST.md\"\u003ethe completed release checklist\u003c/a\u003e.\u003c/li\u003e\n\u003c/ul\u003e\n\u003cdiv class=\"markdown-heading\" dir=\"auto\"\u003e\u003ch2 tabindex=\"-1\" class=\"heading-element\" dir=\"auto\"\u003eBuild and test from source\u003c/h2\u003e\u003ca id=\"user-content-build-and-test-from-source\" class=\"anchor\" aria-label=\"Permalink: Build and test from source\" href=\"#build-and-test-from-source\"\u003e\u003csvg data-component=\"Octicon\" class=\"octicon octicon-link\" viewBox=\"0 0 16 16\" version=\"1.1\" width=\"16\" height=\"16\" aria-hidden=\"true\"\u003e\u003cpath d=\"m7.775 3.275 1.25-1.25a3.5 3.5 0 1 1 4.95 4.95l-2.5 2.5a3.5 3.5 0 0 1-4.95 0 .751.751 0 0 1 .018-1.042.751.751 0 0 1 1.042-.018 1.998 1.998 0 0 0 2.83 0l2.5-2.5a2.002 2.002 0 0 0-2.83-2.83l-1.25 1.25a.751.751 0 0 1-1.042-.018.751.751 0 0 1-.018-1.042Zm-4.69 9.64a1.998 1.998 0 0 0 2.83 0l1.25-1.25a.751.751 0 0 1 1.042.018.751.751 0 0 1 .018 1.042l-1.25 1.25a3.5 3.5 0 1 1-4.95-4.95l2.5-2.5a3.5 3.5 0 0 1 4.95 0 .751.751 0 0 1-.018 1.042.751.751 0 0 1-1.042.018 1.998 1.998 0 0 0-2.83 0l-2.5 2.5a1.998 1.998 0 0 0 0 2.83Z\"\u003e\u003c/path\u003e\u003c/svg\u003e\u003c/a\u003e\u003c/div\u003e\n\u003cp dir=\"auto\"\u003eKujo requires Rust 1.89 or newer:\u003c/p\u003e\n\u003cdiv class=\"highlight highlight-source-shell notranslate position-relative overflow-auto\" dir=\"auto\" data-snippet-clipboard-copy-content=\"git clone https://github.com/kujolang/kujo.git\ncd kujo\ncargo build --release\ncargo test\ncargo run -- test --runtime vm\ncargo run -- test --runtime dual\"\u003e\u003cpre\u003egit clone https://github.com/kujolang/kujo.git\n\u003cspan class=\"pl-c1\"\u003ecd\u003c/span\u003e kujo\ncargo build --release\ncargo \u003cspan class=\"pl-c1\"\u003etest\u003c/span\u003e\ncargo run -- \u003cspan class=\"pl-c1\"\u003etest\u003c/span\u003e --runtime vm\ncargo run -- \u003cspan class=\"pl-c1\"\u003etest\u003c/span\u003e --runtime dual\u003c/pre\u003e\u003c/div\u003e\n\u003cp dir=\"auto\"\u003eThis first-ten-minutes path gives you a normal script, a replay-only AI example,\nand a least-privilege execution example. The longer contributor workflow lives in\n\u003ca href=\"/kujolang/kujo/blob/7a13207019a51e61d3db448bc13f59d5b0e332e5/CONTRIBUTING.md\"\u003eCONTRIBUTING.md\u003c/a\u003e.\u003c/p\u003e\n\u003cdiv class=\"markdown-heading\" dir=\"auto\"\u003e\u003ch2 tabindex=\"-1\" class=\"heading-element\" dir=\"auto\"\u003eCore Reference Links\u003c/h2\u003e\u003ca id=\"user-content-core-reference-links\" class=\"anchor\" aria-label=\"Permalink: Core Reference Links\" href=\"#core-reference-links\"\u003e\u003csvg data-component=\"Octicon\" class=\"octicon octicon-link\" viewBox=\"0 0 16 16\" version=\"1.1\" width=\"16\" height=\"16\" aria-hidden=\"true\"\u003e\u003cpath d=\"m7.775 3.275 1.25-1.25a3.5 3.5 0 1 1 4.95 4.95l-2.5 2.5a3.5 3.5 0 0 1-4.95 0 .751.751 0 0 1 .018-1.042.751.751 0 0 1 1.042-.018 1.998 1.998 0 0 0 2.83 0l2.5-2.5a2.002 2.002 0 0 0-2.83-2.83l-1.25 1.25a.751.751 0 0 1-1.042-.018.751.751 0 0 1-.018-1.042Zm-4.69 9.64a1.998 1.998 0 0 0 2.83 0l1.25-1.25a.751.751 0 0 1 1.042.018.751.751 0 0 1 .018 1.042l-1.25 1.25a3.5 3.5 0 1 1-4.95-4.95l2.5-2.5a3.5 3.5 0 0 1 4.95 0 .751.751 0 0 1-.018 1.042.751.751 0 0 1-1.042.018 1.998 1.998 0 0 0-2.83 0l-2.5 2.5a1.998 1.998 0 0 0 0 2.83Z\"\u003e\u003c/path\u003e\u003c/svg\u003e\u003c/a\u003e\u003c/div\u003e\n\u003cul dir=\"auto\"\u003e\n\u003cli\u003e\u003ca href=\"/kujolang/kujo/blob/7a13207019a51e61d3db448bc13f59d5b0e332e5/docs/LANGUAGE_SPEC.md\"\u003eLanguage specification\u003c/a\u003e\u003c/li\u003e\n\u003cli\u003e\u003ca href=\"/kujolang/kujo/blob/7a13207019a51e61d3db448bc13f59d5b0e332e5/docs/STANDARD_LIBRARY.md\"\u003eStandard library\u003c/a\u003e\u003c/li\u003e\n\u003cli\u003e\u003ca href=\"/kujolang/kujo/blob/7a13207019a51e61d3db448bc13f59d5b0e332e5/docs/AI_RUNTIME.md\"\u003eAI runtime\u003c/a\u003e\u003c/li\u003e\n\u003cli\u003e\u003ca href=\"/kujolang/kujo/blob/7a13207019a51e61d3db448bc13f59d5b0e332e5/docs/CLI_MACHINE_READABLE_CONTRACTS.md\"\u003eCLI machine-readable contracts\u003c/a\u003e\u003c/li\u003e\n\u003cli\u003e\u003ca href=\"/kujolang/kujo/blob/7a13207019a51e61d3db448bc13f59d5b0e332e5/schemas/workflow-control/README.md\"\u003eWorkflow-control JSON contracts\u003c/a\u003e\u003c/li\u003e\n\u003cli\u003e\u003ca href=\"/kujolang/kujo/blob/7a13207019a51e61d3db448bc13f59d5b0e332e5/docs/ARCHITECTURE.md\"\u003eArchitecture\u003c/a\u003e\u003c/li\u003e\n\u003cli\u003e\u003ca href=\"/kujolang/kujo/blob/7a13207019a51e61d3db448bc13f59d5b0e332e5/docs/V1_SCOPE.md\"\u003ev1 scope and deferrals\u003c/a\u003e\u003c/li\u003e\n\u003cli\u003e\u003ca href=\"/kujolang/kujo/blob/7a13207019a51e61d3db448bc13f59d5b0e332e5/docs/OPTIONAL_TYPING_DESIGN.md\"\u003eOptional typing policy\u003c/a\u003e\u003c/li\u003e\n\u003cli\u003e\u003ca href=\"/kujolang/kujo/blob/7a13207019a51e61d3db448bc13f59d5b0e332e5/ROADMAP.md\"\u003eROADMAP.md\u003c/a\u003e\u003c/li\u003e\n\u003cli\u003e\u003ca href=\"/kujolang/kujo/blob/7a13207019a51e61d3db448bc13f59d5b0e332e5/docs/AI_NATIVE_ENTERPRISE_RELEASE_EVIDENCE.md\"\u003eAI-native release evidence\u003c/a\u003e\u003c/li\u003e\n\u003cli\u003e\u003ca href=\"/kujolang/kujo/blob/7a13207019a51e61d3db448bc13f59d5b0e332e5/docs/V1_0_OFFICIAL_RELEASE_CHECKLIST.md\"\u003ev1.0 release checklist\u003c/a\u003e\u003c/li\u003e\n\u003cli\u003e\u003ca href=\"/kujolang/kujo/blob/7a13207019a51e61d3db448bc13f59d5b0e332e5/docs/SECURE_AI_SCRIPTING.md\"\u003eSecure AI scripting\u003c/a\u003e\u003c/li\u003e\n\u003cli\u003e\u003ca href=\"/kujolang/kujo/blob/7a13207019a51e61d3db448bc13f59d5b0e332e5/docs/SECURITY_RESPONSE.md\"\u003eSecurity response\u003c/a\u003e\u003c/li\u003e\n\u003cli\u003e\u003ca href=\"/kujolang/kujo/blob/7a13207019a51e61d3db448bc13f59d5b0e332e5/docs/RELEASE_PROCESS.md\"\u003eRelease process\u003c/a\u003e\u003c/li\u003e\n\u003cli\u003e\u003ca href=\"/kujolang/kujo/blob/7a13207019a51e61d3db448bc13f59d5b0e332e5/docs/VM_INTERPRETER_MIGRATION_PLAYBOOK.md\"\u003eVM/interpreter migration playbook\u003c/a\u003e\u003c/li\u003e\n\u003c/ul\u003e\n\u003cdiv class=\"markdown-heading\" dir=\"auto\"\u003e\u003ch2 tabindex=\"-1\" class=\"heading-element\" dir=\"auto\"\u003eUpgrade\u003c/h2\u003e\u003ca id=\"user-content-upgrade\" class=\"anchor\" aria-label=\"Permalink: Upgrade\" href=\"#upgrade\"\u003e\u003csvg data-component=\"Octicon\" class=\"octicon octicon-link\" viewBox=\"0 0 16 16\" version=\"1.1\" width=\"16\" height=\"16\" aria-hidden=\"true\"\u003e\u003cpath d=\"m7.775 3.275 1.25-1.25a3.5 3.5 0 1 1 4.95 4.95l-2.5 2.5a3.5 3.5 0 0 1-4.95 0 .751.751 0 0 1 .018-1.042.751.751 0 0 1 1.042-.018 1.998 1.998 0 0 0 2.83 0l2.5-2.5a2.002 2.002 0 0 0-2.83-2.83l-1.25 1.25a.751.751 0 0 1-1.042-.018.751.751 0 0 1-.018-1.042Zm-4.69 9.64a1.998 1.998 0 0 0 2.83 0l1.25-1.25a.751.751 0 0 1 1.042.018.751.751 0 0 1 .018 1.042l-1.25 1.25a3.5 3.5 0 1 1-4.95-4.95l2.5-2.5a3.5 3.5 0 0 1 4.95 0 .751.751 0 0 1-.018 1.042.751.751 0 0 1-1.042.018 1.998 1.998 0 0 0-2.83 0l-2.5 2.5a1.998 1.998 0 0 0 0 2.83Z\"\u003e\u003c/path\u003e\u003c/svg\u003e\u003c/a\u003e\u003c/div\u003e\n\u003cp dir=\"auto\"\u003eStandalone releases from v1.3.0 onward can update themselves:\u003c/p\u003e\n\u003cdiv class=\"highlight highlight-source-shell notranslate position-relative overflow-auto\" dir=\"auto\" data-snippet-clipboard-copy-content=\"kujo upgrade --check\nkujo upgrade\"\u003e\u003cpre\u003ekujo upgrade --check\nkujo upgrade\u003c/pre\u003e\u003c/div\u003e\n\u003cp dir=\"auto\"\u003eUse the original package manager for npm or Cargo installs. \u003ccode\u003ekujo upgrade\u003c/code\u003e\nchanges only the runtime; it does not update Kennel, tools, or project packages.\nSee \u003ca href=\"/kujolang/kujo/blob/7a13207019a51e61d3db448bc13f59d5b0e332e5/docs/RUNTIME_UPGRADE.md\"\u003eruntime upgrade and recovery\u003c/a\u003e.\u003c/p\u003e\n\u003cp dir=\"auto\"\u003eKujo is available under the \u003ca href=\"/kujolang/kujo/blob/7a13207019a51e61d3db448bc13f59d5b0e332e5/LICENSE\"\u003eMIT License\u003c/a\u003e.\u003c/p\u003e\n\u003c/article\u003e","richTextTruncated":false,"renderedFileInfo":null,"symbols":{"timed_out":false,"not_analyzed":false,"symbols":[{"name":"Kujo","fully_qualified_name":"Kujo","kind":"section_1","ident_start":2,"ident_end":6,"extent_start":0,"extent_end":9708,"ident_utf16":{"start":{"line_number":0,"utf16_col":2},"end":{"line_number":0,"utf16_col":6}},"extent_utf16":{"start":{"line_number":0,"utf16_col":0},"end":{"line_number":251,"utf16_col":0}}},{"name":"Install","fully_qualified_name":"Install","kind":"section_2","ident_start":556,"ident_end":563,"extent_start":553,"extent_end":1372,"ident_utf16":{"start":{"line_number":11,"utf16_col":3},"end":{"line_number":11,"utf16_col":10}},"extent_utf16":{"start":{"line_number":11,"utf16_col":0},"end":{"line_number":32,"utf16_col":0}}},{"name":"Run your first program","fully_qualified_name":"Run your first program","kind":"section_2","ident_start":1375,"ident_end":1397,"extent_start":1372,"extent_end":1583,"ident_utf16":{"start":{"line_number":32,"utf16_col":3},"end":{"line_number":32,"utf16_col":25}},"extent_utf16":{"start":{"line_number":32,"utf16_col":0},"end":{"line_number":51,"utf16_col":0}}},{"name":"Add packages with Kennel","fully_qualified_name":"Add packages with Kennel","kind":"section_2","ident_start":1586,"ident_end":1610,"extent_start":1583,"extent_end":2440,"ident_utf16":{"start":{"line_number":51,"utf16_col":3},"end":{"line_number":51,"utf16_col":27}},"extent_utf16":{"start":{"line_n