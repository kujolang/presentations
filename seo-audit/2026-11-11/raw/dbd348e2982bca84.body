,"childPages":[]},{"href":"/en/copilot/tutorials/cloud-agent/improve-a-project","title":"Improve a project","childPages":[]},{"href":"/en/copilot/tutorials/cloud-agent/build-guardrails","title":"Build enterprise guardrails","childPages":[]},{"href":"/en/copilot/tutorials/cloud-agent/give-access-to-resources","title":"Give access to resources","childPages":[]}]},{"href":"/en/copilot/tutorials/budgets","title":"Set up budgets","childPages":[{"href":"/en/copilot/tutorials/budgets/getting-started-with-budget-controls","title":"Get started with budgets","childPages":[]},{"href":"/en/copilot/tutorials/budgets/optimizing-your-budget-configuration","title":"Optimize budget configuration","childPages":[]}]},{"href":"/en/copilot/tutorials/customize-code-review","title":"Customize code review","childPages":[]},{"href":"/en/copilot/tutorials/use-copilot-code-review-across-the-pull-request-lifecycle","title":"Pull request lifecycle","childPages":[]},{"href":"/en/copilot/tutorials/enhance-agent-mode-with-mcp","title":"Enhance agent mode with MCP","childPages":[]},{"href":"/en/copilot/tutorials/speed-up-development-work","title":"Speed up development work","childPages":[]},{"href":"/en/copilot/tutorials/roll-out-at-scale","title":"Roll out at scale","childPages":[{"href":"/en/copilot/tutorials/roll-out-at-scale/assign-licenses","title":"Assign licenses","childPages":[{"href":"/en/copilot/tutorials/roll-out-at-scale/assign-licenses/choose-enterprise-plan","title":"Choose enterprise plan","childPages":[]},{"href":"/en/copilot/tutorials/roll-out-at-scale/assign-licenses/set-up-self-serve-licenses","title":"Set up self-serve licenses","childPages":[]},{"href":"/en/copilot/tutorials/roll-out-at-scale/assign-licenses/track-usage-and-adoption","title":"Track usage and adoption","childPages":[]},{"href":"/en/copilot/tutorials/roll-out-at-scale/assign-licenses/remind-inactive-users","title":"Remind inactive users","childPages":[],"layout":"inline"}]},{"href":"/en/copilot/tutorials/roll-out-at-scale/govern-at-scale","title":"Govern at scale","childPages":[{"href":"/en/copilot/tutorials/roll-out-at-scale/govern-at-scale/resources-for-approval","title":"Resources for approval","childPages":[]},{"href":"/en/copilot/tutorials/roll-out-at-scale/govern-at-scale/establish-ai-managers","title":"Establish AI managers","childPages":[]},{"href":"/en/copilot/tutorials/roll-out-at-scale/govern-at-scale/govern-for-adoption","title":"Govern for adoption","childPages":[]},{"href":"/en/copilot/tutorials/roll-out-at-scale/govern-at-scale/pilot-a-feature-or-model","title":"Pilot a feature or model","childPages":[]},{"href":"/en/copilot/tutorials/roll-out-at-scale/govern-at-scale/maintain-codebase-standards","title":"Maintain codebase standards","childPages":[]}]},{"href":"/en/copilot/tutorials/roll-out-at-scale/enable-developers","title":"Enable developers","childPages":[{"href":"/en/copilot/tutorials/roll-out-at-scale/enable-developers/drive-adoption","title":"Drive adoption","childPages":[]},{"href":"/en/copilot/tutorials/roll-out-at-scale/enable-developers/copilot-app-for-teams","title":"Roll out the Copilot app","childPages":[]},{"href":"/en/copilot/tutorials/roll-out-at-scale/enable-developers/integrate-ai-agents","title":"Understand agent workflows","childPages":[]},{"href":"/en/copilot/tutorials/roll-out-at-scale/enable-developers/drive-team-agentic-adoption","title":"Drive agentic adoption","childPages":[]}]},{"href":"/en/copilot/tutorials/roll-out-at-scale/drive-downstream-impact","title":"Drive downstream impact","childPages":[{"href":"/en/copilot/tutorials/roll-out-at-scale/drive-downstream-impact/achieve-company-goals","title":"Achieve company goals","childPages":[]},{"href":"/en/copilot/tutorials/roll-out-at-scale/drive-downstream-impact/increase-test-coverage","title":"Increase test coverage","childPages":[]},{"href":"/en/copilot/tutorials/roll-out-at-scale/drive-downstream-impact/accelerate-pull-requests","title":"Accelerate pull requests","childPages":[]},{"href":"/en/copilot/tutorials/roll-out-at-scale/drive-downstream-impact/reduce-security-debt","title":"Reduce security debt","childPages":[]}]},{"href":"/en/copilot/tutorials/roll-out-at-scale/measure-copilot-impact","title":"Copilot usage metrics","childPages":[],"layout":"journey-landing"},{"href":"/en/copilot/tutorials/roll-out-at-scale/communicate-copilot-impact","title":"Communicate impact","childPages":[]},{"href":"/en/copilot/tutorials/roll-out-at-scale/measure-success","title":"Measure trial success","childPages":[]}]},{"href":"/en/copilot/tutorials/explore-a-codebase","title":"Explore a codebase","childPages":[]},{"href":"/en/copilot/tutorials/explore-issues-and-discussions","title":"Explore issues and discussions","childPages":[]},{"href":"/en/copilot/tutorials/explore-pull-requests","title":"Explore pull requests","childPages":[]},{"href":"/en/copilot/tutorials/write-tests","title":"Write tests","childPages":[]},{"href":"/en/copilot/tutorials/optimize-ai-usage","title":"Optimize AI usage","childPages":[]},{"href":"/en/copilot/tutorials/optimize-chat-usage","title":"Optimize Chat usage","childPages":[]},{"href":"/en/copilot/tutorials/optimize-code-reviews","title":"Optimize code reviews","childPages":[]},{"href":"/en/copilot/tutorials/reduce-technical-debt","title":"Reduce technical debt","childPages":[]},{"href":"/en/copilot/tutorials/stack-ai-generated-code-in-pull-requests","title":"Stack AI pull requests","childPages":[]},{"href":"/en/copilot/tutorials/review-ai-generated-code","title":"Review AI code","childPages":[]},{"href":"/en/copilot/tutorials/vibe-coding","title":"Vibe coding","childPages":[]},{"href":"/en/copilot/tutorials/copilot-cli-hooks","title":"Roll out CLI hooks","childPages":[]},{"href":"/en/copilot/tutorials/use-an-ai-sme","title":"Use an AI SME","childPages":[]},{"href":"/en/copilot/tutorials/create-an-extension","title":"Create CLI extensions","childPages":[]}],"sidebarLink":{"text":"All tutorials","href":"/en/copilot/tutorials"},"layout":"bespoke-landing"},{"href":"/en/copilot/responsible-use","title":"Responsible use","childPages":[{"href":"/en/copilot/responsible-use/chat","title":"Chat","childPages":[]},{"href":"/en/copilot/responsible-use/inline-suggestions","title":"Inline suggestions","childPages":[]},{"href":"/en/copilot/responsible-use/agents","title":"Agents","childPages":[]}]}],"layout":"discovery-landing"},"status":200,"xHost":"docs.github.com"},"articleContext":{"title":"GitHub Copilot on GitHub.com and GitHub Mobile","intro":"\u003cp\u003eMove from repository questions to planned code changes and review in one continuous session with GitHub Copilot on GitHub.com and GitHub Mobile.\u003c/p\u003e","effectiveDate":"","renderedPage":"\u003cp\u003eOn the GitHub website and GitHub Mobile, GitHub Copilot can answer questions about your repositories, plan and make changes, review pull requests, and automate repository tasks. You can ask questions and delegate work from a conversation, and use Copilot directly in your issue and pull request workflows.\u003c/p\u003e\n\u003cp\u003eWith the new \u003cstrong\u003eCopilot in the cloud\u003c/strong\u003e experience, you can move between web or mobile and local clients (Copilot app, VS Code, or Copilot CLI), working with and steering Copilot in the same session.\u003c/p\u003e\n\u003cdiv class=\"ghd-alert ghd-alert-accent\" data-container=\"alert\"\u003e\u003cp class=\"ghd-alert-title\"\u003e\u003csvg version=\"1.1\" width=\"16\" height=\"16\" viewBox=\"0 0 16 16\" class=\"octicon mr-2\" aria-hidden\u003e\u003cpath d=\"M0 8a8 8 0 1 1 16 0A8 8 0 0 1 0 8Zm8-6.5a6.5 6.5 0 1 0 0 13 6.5 6.5 0 0 0 0-13ZM6.5 7.75A.75.75 0 0 1 7.25 7h1a.75.75 0 0 1 .75.75v2.75h.25a.75.75 0 0 1 0 1.5h-2a.75.75 0 0 1 0-1.5h.25v-2h-.25a.75.75 0 0 1-.75-.75ZM8 6a1 1 0 1 1 0-2 1 1 0 0 1 0 2Z\"\u003e\u003c/path\u003e\u003c/svg\u003eNote\u003c/p\u003e\n\u003cp\u003e\nStarting October 28, 2026, the new Copilot in the cloud experience on GitHub.com and GitHub Mobile is available to users with a paid Copilot plan, subject to applicable organization and enterprise policies. Users on Copilot Free plans will continue to use the old Copilot Chat experience.\u003c/p\u003e\n\u003c/div\u003e\n\u003cp\u003eThis article explains both the newer Copilot in the cloud experience and the older Copilot cloud agent plus Copilot Chat experience. For a quick overview of what's changing, see \u003ca href=\"#comparison-of-the-two-experiences\"\u003eComparison of the two experiences\u003c/a\u003e.\u003c/p\u003e\n\u003ch2 id=\"how-copilot-helps-on-githubcom-and-github-mobile\" tabindex=\"-1\"\u003e\u003ca class=\"heading-link\" href=\"#how-copilot-helps-on-githubcom-and-github-mobile\"\u003eHow Copilot helps on GitHub.com and GitHub Mobile\u003cspan class=\"heading-link-symbol\" aria-hidden=\"true\"\u003e\u003c/span\u003e\u003c/a\u003e\u003c/h2\u003e\n\u003cp\u003eYou can combine chat, agentic work, code review, and automations in your repository workflows.\u003c/p\u003e\n\u003cp\u003eFor example, you might use chat to understand how a repository handles authentication, then ask Copilot to plan and add missing tests. Once the changes are in a pull request, you can request a review from Copilot. To maintain test coverage over time, you could set up an automation to check for missing tests each week and propose additions for you to review.\u003c/p\u003e\n\u003ch2 id=\"key-concepts-for-copilot-in-the-cloud\" tabindex=\"-1\"\u003e\u003ca class=\"heading-link\" href=\"#key-concepts-for-copilot-in-the-cloud\"\u003eKey concepts for Copilot in the cloud\u003cspan class=\"heading-link-symbol\" aria-hidden=\"true\"\u003e\u003c/span\u003e\u003c/a\u003e\u003c/h2\u003e\n\u003cp\u003eCopilot in the cloud allows for a continuous task flow. Copilot sessions that you start on in a cloud environment on GitHub can continue seamlessly across different clients, such as the GitHub Copilot app, your IDE, mobile, and CLI. Your work and context are preserved across these clients, meaning you can move from asking questions to agentic work to task completion, in the same conversation.\u003c/p\u003e\n\u003ch3 id=\"client-session-and-environment\" tabindex=\"-1\"\u003e\u003ca class=\"heading-link\" href=\"#client-session-and-environment\"\u003eClient, session, and environment\u003cspan class=\"heading-link-symbol\" aria-hidden=\"true\"\u003e\u003c/span\u003e\u003c/a\u003e\u003c/h3\u003e\n\u003cp\u003eThere are three key components to understand in the task flow: the client, the session, and the environment.\u003c/p\u003e\n\u003cp\u003eTo start an agent task, you interact with Copilot through a client or surface, such as the web interface, GitHub Copilot app, IDE, GitHub Mobile, or GitHub Copilot CLI.\u003c/p\u003e\n\u003cp\u003eA session is the conversation and activity associated with agentic work, including the prompts you provide and the responses generated by Copilot.\u003c/p\u003e\n\u003cp\u003eAn environment is the place where the agent executes its work, such as a cloud sandbox, a GitHub Actions runner, or a remote custom environment.\u003c/p\u003e\n\u003cp\u003eFor more information, see \u003ca href=\"/en/copilot/concepts/security-governance-and-network-settings/about-cloud-sandboxes\"\u003eAbout cloud sandboxes for GitHub Copilot\u003c/a\u003e, \u003ca href=\"/en/copilot/concepts/security-governance-and-network-settings/about-cloud-and-local-sandboxes\"\u003eAbout local sandboxing for GitHub Copilot\u003c/a\u003e, and \u003ca href=\"/en/copilot/concepts/copilot-surfaces/copilot-in-ides\"\u003eGitHub Copilot in IDEs\u003c/a\u003e.\u003c/p\u003e\n\u003ch3 id=\"session-context\" tabindex=\"-1\"\u003e\u003ca class=\"heading-link\" href=\"#session-context\"\u003eSession context\u003cspan class=\"heading-link-symbol\" aria-hidden=\"true\"\u003e\u003c/span\u003e\u003c/a\u003e\u003c/h3\u003e\n\u003cp\u003eYou can start a chat session with the following contexts automatically attached:\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003eAll repositories, owned by you or by an organization.\u003c/li\u003e\n\u003cli\u003eA specific file, issue, pull request.\u003c/li\u003e\n\u003cli\u003eA specific repository and branch.\u003c/li\u003e\n\u003cli\u003eA space.\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003eYou can attach context with the repository selector, the \u003cstrong\u003e+\u003c/strong\u003e menu, or \u003cstrong\u003e@\u003c/strong\u003e mentions.\u003c/p\u003e\n\u003cp\u003eTo let Copilot retrieve information from supported services during a task, use customizations such as Copilot connectors and personal custom Model Context Protocol (MCP) servers.\u003c/p\u003e\n\u003cp\u003eSession context is distinct from Copilot Memory, which builds a longer-term, persistent understanding of your repositories and preferences across sessions. For more information, see \u003ca href=\"/en/copilot/concepts/prompting-and-context/copilot-memory\"\u003eAbout GitHub Copilot Memory\u003c/a\u003e.\u003c/p\u003e\n\u003ch3 id=\"sessions-across-surfaces\" tabindex=\"-1\"\u003e\u003ca class=\"heading-link\" href=\"#sessions-across-surfaces\"\u003eSessions across surfaces\u003cspan class=\"heading-link-symbol\" aria-hidden=\"true\"\u003e\u003c/span\u003e\u003c/a\u003e\u003c/h3\u003e\n\u003cp\u003eChoose a cloud sandbox when you want to continue a session across supported Copilot surfaces. You can start a cloud session on one surface and continue it on another.\u003c/p\u003e\n\u003ch3 id=\"comparison-of-github-actions-based-sessions-and-cloud-sandboxes\" tabindex=\"-1\"\u003e\u003ca class=\"heading-link\" href=\"#comparison-of-github-actions-based-sessions-and-cloud-sandboxes\"\u003eComparison of GitHub Actions-based sessions and cloud sandboxes\u003cspan class=\"heading-link-symbol\" aria-hidden=\"true\"\u003e\u003c/span\u003e\u003c/a\u003e\u003c/h3\u003e\n\u003cp\u003eIn Copilot in the cloud, you have three environment choices: Cloud (a cloud sandbox), GitHub Actions-based, and Remote (a connection to a custom environment).\u003c/p\u003e\n\u003cp\u003eInitial performance testing on GitHub indicates that sessions in cloud sandboxes completed execution faster on average than GitHub Actions-based sessions.\u003c/p\u003e\n\u003cp\u003eThe following table compares GitHub Actions-based sessions and cloud sandbox-based sessions.\u003c/p\u003e\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\u003ctable aria-labelledby=\"comparison-of-github-actions-based-sessions-and-cloud-sandboxes\"\u003e\u003cthead\u003e\u003ctr\u003e\u003cth scope=\"col\"\u003e\u003c/th\u003e\u003cth scope=\"col\"\u003eGitHub Actions\u003c/th\u003e\u003cth scope=\"col\"\u003eCloud sandbox\u003c/th\u003e\u003c/tr\u003e\u003c/thead\u003e\u003ctbody\u003e\u003ctr\u003e\u003ctd\u003e\u003cstrong\u003eSession continuity\u003c/strong\u003e\u003c/td\u003e\u003ctd\u003eSessions are only available on the GitHub website.\u003c/td\u003e\u003ctd\u003eSessions can be shared and resumed across clients.\u003c/td\u003e\u003c/tr\u003e\u003ctr\u003e\u003ctd\u003e\u003cstrong\u003eRepository scoping\u003c/strong\u003e\u003c/td\u003e\u003ctd\u003eSessions require a repository. Changes are made only in the specific, single repository context.\u003c/td\u003e\u003ctd\u003eSessions can span across repositories in one organization. Changes can be made across multiple repositories\u003c/td\u003e\u003c/tr\u003e\u003ctr\u003e\u003ctd\u003e\u003cstrong\u003eChat data retention\u003c/strong\u003e\u003c/td\u003e\u003ctd\u003eData is retained for 28 days.\u003c/td\u003e\u003ctd\u003eData is retained for the life of the account.\u003c/td\u003e\u003c/tr\u003e\u003ctr\u003e\u003ctd\u003e\u003cstrong\u003eCustom environments\u003c/strong\u003e\u003c/td\u003e\u003ctd\u003eSupports GitHub Actions-specific custom compute, network and setup configuration, and self-hosted runners.\u003c/td\u003e\u003ctd\u003eCloud sandboxes honor repository and organization firewall allowlists, but do not support custom compute, GitHub Actions-specific setup steps, or self-hosted runners.\u003c/td\u003e\u003c/tr\u003e\u003ctr\u003e\u003ctd\u003e\u003cstrong\u003eCustomizations and tool sharing\u003c/strong\u003e\u003c/td\u003e\u003ctd\u003eSupports custom instructions, MCP servers, and content exclusions.\u003c/td\u003e\u003ctd\u003eSupports custom instructions, dotfiles personalization, repository and personal MCP servers, connectors, and content exclusions with a single configuration across all cloud sandboxes.\u003c/td\u003e\u003c/tr\u003e\u003ctr\u003e\u003ctd\u003e\u003cstrong\u003eWhy choose this environment\u003c/strong\u003e\u003c/td\u003e\u003ctd\u003eSuitable when you need repository-specific integrations, custom environments, or self-hosted runners.\u003c/td\u003e\u003ctd\u003eSuitable for cross-repository chat, quick access to AI models, and when custom compute or network configurations are not required in cloud sandboxes.\u003c/td\u003e\u003c/tr\u003e\u003c/tbody\u003e\u003c/table\u003e\n\u003cp\u003eIn the Copilot in the cloud experience, cloud and GitHub Actions compute draw on the same monthly GitHub account allowance, separate from AI credits. For details, see \u003ca href=\"/en/billing/concepts/product-billing/cloud-and-local-sandboxes\"\u003eBilling for cloud and local sandboxes for GitHub Copilot\u003c/a\u003e.\u003c/p\u003e\n\u003ch2 id=\"access-and-availability\" tabindex=\"-1\"\u003e\u003ca class=\"heading-link\" href=\"#access-and-availability\"\u003eAccess and availability\u003cspan class=\"heading-link-symbol\" aria-hidden=\"true\"\u003e\u003c/span\u003e\u003c/a\u003e\u003c/h2\u003e\n\u003cp\u003eAvailable Copilot features depend on your plan and organization policies. For setup guidance, see \u003ca href=\"/en/copilot/how-tos/copilot-on-github/set-up-copilot\"\u003eSet up Copilot\u003c/a\u003e. For usage allowances and costs, see \u003ca href=\"/en/copilot/concepts/billing-and-usage\"\u003eGitHub Copilot billing and usage\u003c/a\u003e.\u003c/p\u003e\n\u003cp\u003eRepository owners and administrators can disable Copilot for particular repositories, even when your plan and policies otherwise allow you to use it. Organization and enterprise policies continue to apply. See \u003ca href=\"/en/copilot/concepts/enterprise/cloud-agent-access\"\u003eManaging GitHub Copilot in the cloud for your enterprise or organization\u003c/a\u003e.\u003c/p\u003e\n\u003cp\u003eTo view organization data or sessions, you must meet your organization's single sign-on requirements.\u003c/p\u003e\n\u003cp\u003eWithout write access to a repository, your Copilot session is read-only.\u003c/p\u003e\n\u003ch2 id=\"starting-with-copilot-on-githubcom-and-github-mobile\" tabindex=\"-1\"\u003e\u003ca class=\"heading-link\" href=\"#starting-with-copilot-on-githubcom-and-github-mobile\"\u003eStarting with Copilot on GitHub.com and GitHub Mobile\u003cspan class=\"heading-link-symbol\" aria-hidden=\"true\"\u003e\u003c/span\u003e\u003c/a\u003e\u003c/h2\u003e\n\u003cp\u003eYou can start working with Copilot from several different entry points:\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003eYour Copilot home page at \u003ca href=\"https://github.com/copilot?ref_product=copilot\u0026#x26;ref_type=engagement\u0026#x26;ref_style=text\u0026#x26;utm_source=dotcom-surface-doc-home\u0026#x26;utm_medium=docs\u0026#x26;utm_campaign=universe-2026\"\u003egithub.com/copilot\u003c/a\u003e\u003c/li\u003e\n\u003cli\u003eThe Copilot panel, displayed when starting a session within a file, issue, or pull request\u003c/li\u003e\n\u003cli\u003eYour GitHub dashboard at \u003ca href=\"https://github.com?ref_product=copilot\u0026#x26;ref_type=engagement\u0026#x26;ref_style=text\u0026#x26;utm_source=dotcom-surface-concept-doc\u0026#x26;utm_medium=docs\u0026#x26;utm_campaign=universe-2026\"\u003egithub.com\u003c/a\u003e\u003c/li\u003e\n\u003cli\u003eThe \u003cstrong\u003eAgents\u003c/strong\u003e tab or panel within a repository\u003c/li\u003e\n\u003c/ul\u003e\n\u003ch2 id=\"ways-to-work-with-copilot\" tabindex=\"-1\"\u003e\u003ca class=\"heading-link\" href=\"#ways-to-work-with-copilot\"\u003eWays to work with Copilot\u003cspan class=\"heading-link-symbol\" aria-hidden=\"true\"\u003e\u003c/span\u003e\u003c/a\u003e\u003c/h2\u003e\n\u003cp\u003eYou can work with Copilot in several ways:\u003c/p\u003e\n\u003ch3 id=\"asking-questions\" tabindex=\"-1\"\u003e\u003ca class=\"heading-link\" href=\"#asking-questions\"\u003eAsking questions\u003cspan class=\"heading-link-symbol\" aria-hidden=\"true\"\u003e\u003c/span\u003e\u003c/a\u003e\u003c/h3\u003e\n\u003cp\u003eChat can explain unfamiliar code, suggest fixes, generate tests, or compare approaches. Follow-up questions let you refine your request without starting a new conversation.\u003c/p\u003e\n\u003cp\u003eChat is preconfigured with tools for tasks such as creating branches, updating files, and creating or updating issues. It also supports semantic code search, limited to default branches only.\u003c/p\u003e\n\u003ch3 id=\"agentic-work\" tabindex=\"-1\"\u003e\u003ca class=\"heading-link\" href=\"#agentic-work\"\u003eAgentic work\u003cspan class=\"heading-link-symbol\" aria-hidden=\"true\"\u003e\u003c/span\u003e\u003c/a\u003e\u003c/h3\u003e\n\u003cp\u003eCopilot can research a repository, plan changes, and implement them in the background. It can edit files and run tests and linters in a cloud development environment, rather than your local IDE.\u003c/p\u003e\n\u003cp\u003eWhen you ask for changes, Copilot works against the repository and branch you provided. You can review the proposed changes and ask for refinements before creating a pull request, or request a pull request in your prompt.\u003c/p\u003e\n\u003cp\u003eFrom security campaigns, you can assign code scanning alerts to Copilot for fixes. See \u003ca href=\"/en/code-security/how-tos/manage-security-alerts/remediate-alerts-at-scale/fixing-alerts-in-security-campaign#assigning-alerts-to-copilot\"\u003eFixing alerts in a security campaign\u003c/a\u003e.\u003c/p\u003e\n\u003ch3 id=\"code-review\" tabindex=\"-1\"\u003e\u003ca class=\"heading-link\" href=\"#code-review\"\u003eCode review\u003cspan class=\"heading-link-symbol\" aria-hidden=\"true\"\u003e\u003c/span\u003e\u003c/a\u003e\u003c/h3\u003e\n\u003cp\u003eOn GitHub, Copilot code review reviews pull request changes, identifies potential issues, and suggests fixes. It uses agentic capabilities to gather context from your repository. You can request a review or configure automatic reviews, then review and apply the suggested changes. See \u003ca href=\"/en/copilot/concepts/agent-capabilities/agent-powered-workflows-and-operations/code-review\"\u003eGitHub Copilot code review\u003c/a\u003e.\u003c/p\u003e\n\u003cp\u003eCopilot can also generate a summary of your changes directly in a pull request description or comment. This helps reviewers understand the changes, but is separate from reviewing the code. See \u003ca href=\"/en/copilot/how-tos/copilot-on-github/copilot-for-github-tasks/create-a-pr-summary\"\u003eCreating a pull request summary with GitHub Copilot\u003c/a\u003e.\u003c/p\u003e\n\u003ch3 id=\"getting-pull-requests-ready-to-merge\" tabindex=\"-1\"\u003e\u003ca class=\"heading-link\" href=\"#getting-pull-requests-ready-to-merge\"\u003eGetting pull requests ready to merge\u003cspan class=\"heading-link-symbol\" aria-hidden=\"true\"\u003e\u003c/span\u003e\u003c/a\u003e\u003c/h3\u003e\n\u003cp\u003eWith Agent Merge, Copilot watches a pull request and works on the blockers you select: failed GitHub Actions workflows, merge conflicts, or both. Enable it with \u003cstrong\u003eWatch and fix\u003c/strong\u003e in the pull request's merge box. You can also enable it automatically for pull requests you create. See \u003ca href=\"/en/copilot/how-tos/copilot-on-github/use-copilot-agents/get-pull-requests-ready-to-merge\"\u003eGetting pull requests ready to merge with Agent Merge\u003c/a\u003e.\u003c/p\u003e\n\u003ch3 id=\"automations-and-agentic-workflows\" tabindex=\"-1\"\u003e\u003ca class=\"heading-link\" href=\"#automations-and-agentic-workflows\"\u003eAutomations and agentic workflows\u003cspan class=\"heading-link-symbol\" aria-hidden=\"true\"\u003e\u003c/span\u003e\u003c/a\u003e\u003c/h3\u003e\n\u003cp\u003eAutomations let you define a task once and have Copilot run it on a schedule or in response to repository events. For example, an automation can triage issues or prepare weekly release notes. You create and manage automations from the \u003cstrong\u003eAgents\u003c/strong\u003e tab in a repository on GitHub.com. Automations are available in eligible private and internal repositories. See \u003ca href=\"/en/copilot/concepts/agent-capabilities/agent-powered-workflows-and-operations/about-automations\"\u003eCopilot automations\u003c/a\u003e.\u003c/p\u003e\n\u003cp\u003eGitHub Agentic Workflows provide another way to automate tasks in your repositories on GitHub.com. You define tasks in natural language in Markdown files, and they run as GitHub Actions workflows. These workflows can use Copilot or another supported coding agent. See \u003ca href=\"/en/copilot/concepts/agent-capabilities/agent-powered-workflows-and-operations/about-github-agentic-workflows\"\u003eGitHub Agentic Workflows\u003c/a\u003e.\u003c/p\u003e\n\u003ch2 id=\"session-history-and-remote-control\" tabindex=\"-1\"\u003e\u003ca class=\"heading-link\" href=\"#session-history-and-remote-control\"\u003eSession history and remote control\u003cspan class=\"heading-link-symbol\" aria-hidden=\"true\"\u003e\u003c/span\u003e\u003c/a\u003e\u003c/h2\u003e\n\u003cp\u003eOn GitHub, session logs show the work and tools used. Shared sessions and pull requests let teammates with repository access follow the work and review changes. Logs do not replace your own review and testing. See \u003ca href=\"/en/copilot/how-tos/copilot-on-github/use-copilot-agents/manage-and-track-agents\"\u003eManaging agent sessions\u003c/a\u003e.\u003c/p\u003e\n\u003cp\u003eTo monitor and steer a session started from GitHub Copilot CLI, enable remote control. The session continues running on your original local machine, which must stay online. See \u003ca href=\"/en/copilot/concepts/agent-capabilities/agent-powered-workflows-and-operations/about-remote-control\"\u003eRemote control of GitHub Copilot CLI sessions\u003c/a\u003e.\u003c/p\u003e\n\u003cp\u003eYou can ask Copilot about your synced session history across Copilot surfaces. This includes Copilot in the cloud and Copilot code review sessions, and sessions from GitHub Copilot CLI, VS Code, JetBrains IDEs, and the GitHub Copilot app.\u003c/p\u003e\n\u003cp\u003eYou can only query sessions you started. Syncing must be enabled and permitted by your organization's policies. See \u003ca href=\"/en/copilot/how-tos/copilot-on-github/use-copilot-agents/manage-and-track-agents#query-past-sessions\"\u003eQuery past sessions\u003c/a\u003e.\u003c/p\u003e\n\u003ch2 id=\"customize-your-experience\" tabindex=\"-1\"\u003e\u003ca class=\"heading-link\" href=\"#customize-your-experience\"\u003eCustomize your experience\u003cspan class=\"heading-link-symbol\" aria-hidden=\"true\"\u003e\u003c/span\u003e\u003c/a\u003e\u003c/h2\u003e\n\u003cp\u003eThere are several ways to customize your experience with Copilot.\u003c/p\u003e\n\u003ch3 id=\"instructions-tools-and-shared-context\" tabindex=\"-1\"\u003e\u003ca class=\"heading-link\" href=\"#instructions-tools-and-shared-context\"\u003eInstructions, tools, and shared context\u003cspan class=\"heading-link-symbol\" aria-hidden=\"true\"\u003e\u003c/span\u003e\u003c/a\u003e\u003c/h3\u003e\n\u003cp\u003eOn GitHub, custom instructions let you save personal preferences for chat, repository conventions, and organization guidance.\u003c/p\u003e\n\u003cp\u003eCopilot Spaces organize shared context for questions.\u003c/p\u003e\n\u003cp\u003eFor delegated work, custom agents and agent skills provide task-specific instructions and resources. MCP servers connect agents to additional tools and data.\u003c/p\u003e\n\u003cp\u003eHooks can run commands during agent work for validation or logging. For setup guidance, see \u003ca href=\"/en/copilot/how-tos/copilot-on-github/customize-copilot\"\u003eCustomize Copilot\u003c/a\u003e.\u003c/p\u003e\n\u003ch3 id=\"customizations-for-copilot-in-the-cloud\" tabindex=\"-1\"\u003e\u003ca class=\"heading-link\" href=\"#customizations-for-copilot-in-the-cloud\"\u003eCustomizations for Copilot in the cloud\u003cspan class=\"heading-link-symbol\" aria-hidden=\"true\"\u003e\u003c/span\u003e\u003c/a\u003e\u003c/h3\u003e\n\u003cp\u003eIn cloud sandboxes, you can also use a dotfiles repository to bring your personal instructions, skills, and custom agents to your sessions across repositories. This dotfiles personalization does not apply to GitHub Actions-based sessions. For setup guidance, see \u003ca href=\"/en/copilot/how-tos/copilot-on-github/customize-copilot/customize-cloud-agent/personalize-cloud-sessions\"\u003ePersonalizing your cloud sessions\u003c/a\u003e.\u003c/p\u003e\n\u003cp\u003eTo bring tools and context into Copilot, you can access third-party services through GitHub connectors. Connectors are available to all your Copilot in the cloud sessions. You can also configure personal MCP server configurations to allow Copilot access to your personal tools and context. These customizations do not apply to GitHub Actions-based sessions. See \u003ca href=\"/en/copilot/concepts/customizations/copilot-connectors\"\u003eCopilot connectors\u003c/a\u003e and \u003ca href=\"/en/copilot/concepts/customizations/mcp\"\u003eModel Context Protocol (MCP)\u003c/a\u003e.\u003c/p\u003e\n\u003cp\u003eSome existing Spaces that include data from multiple organizations or mix private and organization data may not work the same way in Copilot in the cloud. For steps to restore chat use in Spaces containing incompatible private sources, see \u003ca href=\"/en/copilot/how-tos/copilot-on-github/customize-copilot/copilot-spaces/create-copilot-spaces#restoring-chat-use-in-spaces-with-incompatible-private-sources\"\u003eCreating GitHub Copilot Spaces\u003c/a\u003e.\u003c/p\u003e\n\u003ch3 id=\"ai-models\" tabindex=\"-1\"\u003e\u003ca class=\"heading-link\" href=\"#ai-models\"\u003eAI models\u003cspan class=\"heading-link-symbol\" aria-hidden=\"true\"\u003e\u003c/span\u003e\u003c/a\u003e\u003c/h3\u003e\n\u003cp\u003eYou can change the model Copilot uses to generate responses. You may find that different models perform better, or provide more useful responses, depending on the type of questions you ask. Options include premium models with advanced capabilities. To change the model in your IDE, see \u003ca href=\"/en/copilot/how-tos/copilot-in-your-ide/chat-with-copilot/change-the-chat-model\"\u003eChanging the AI model for GitHub Copilot Chat\u003c/a\u003e. To change or compare models on GitHub, see \u003ca href=\"/en/copilot/how-tos/copilot-on-github/chat-with-copilot/chat-in-github#changing-and-comparing-ai-models\"\u003eAsking GitHub Copilot questions in GitHub\u003c/a\u003e.\u003c/p\u003e\n\u003cp\u003eOn GitHub.com and GitHub Mobile, available models depend on your plan and account policies. See \u003ca href=\"/en/copilot/reference/ai-models/supported-models\"\u003eSupported AI models in GitHub Copilot\u003c/a\u003e.\u003c/p\u003e\n\u003cp\u003eFor Copilot in the cloud, the ability to select a model also depends on how you start the task. See \u003ca href=\"/en/copilot/how-tos/use-copilot-agents/cloud-agent/changing-the-ai-model\"\u003eChanging the AI model for GitHub Copilot cloud agent\u003c/a\u003e.\u003c/p\u003e\n\u003ch2 id=\"copilot-limitations-and-compatibility\" tabindex=\"-1\"\u003e\u003ca class=\"heading-link\" href=\"#copilot-limitations-and-compatibility\"\u003eCopilot limitations and compatibility\u003cspan class=\"heading-link-symbol\" aria-hidden=\"true\"\u003e\u003c/span\u003e\u003c/a\u003e\u003c/h2\u003e\n\u003cp\u003eCopilot can produce incorrect or suboptimal code, including code that contains security vulnerabilities. Review and test the output before using it in production. See \u003ca href=\"/en/copilot/responsible-use/agents\"\u003eApplication card: GitHub Copilot Agents\u003c/a\u003e.\u003c/p\u003e\n\u003cp\u003eFor information about built-in security protections, see \u003ca href=\"/en/copilot/concepts/security-governance-and-network-settings/risks-and-mitigations\"\u003eRisks and mitigations for GitHub Copilot cloud agent\u003c/a\u003e.\u003c/p\u003e\n\u003ch3 id=\"copilot-work-limitations\" tabindex=\"-1\"\u003e\u003ca class=\"heading-link\" href=\"#copilot-work-limitations\"\u003eCopilot work limitations\u003cspan class=\"heading-link-symbol\" aria-hidden=\"true\"\u003e\u003c/span\u003e\u003c/a\u003e\u003c/h3\u003e\n\u003cul\u003e\n\u003cli\u003e\u003cstrong\u003eRepository scope\u003c/strong\u003e: When Copilot runs on GitHub Actions, Copilot can only make changes in the repository specified when you start a task. It cannot make changes across multiple repositories in one run. However, sessions that run in a cloud sandbox \u003cem\u003ecan\u003c/em\u003e work across multiple repositories.\u003c/li\u003e\n\u003cli\u003e\u003cstrong\u003eContext access\u003c/strong\u003e: In GitHub Actions-based sessions, the GitHub MCP server only provides access by default to context in the repository where the agent is working, such as issues and previous pull requests. You can configure broader access through repository MCP settings. See \u003ca href=\"/en/copilot/how-tos/copilot-on-github/customize-copilot/configure-mcp-servers\"\u003eConfigure MCP servers for your repository\u003c/a\u003e. For sessions in cloud sandboxes, you can give additional context by configuring access to third-party services through GitHub connectors and personal custom MCP servers, see \u003ca href=\"/en/copilot/concepts/customizations/copilot-connectors\"\u003eCopilot connectors\u003c/a\u003e and \u003ca href=\"/en/copilot/concepts/customizations/mcp#personal-mcp-servers\"\u003eModel Context Protocol (MCP)\u003c/a\u003e.\u003c/li\u003e\n\u003cli\u003e\u003cstrong\u003eBranches and pull requests\u003c/strong\u003e: In GitHub Actions-based sessions and cloud sandbox sessions, Copilot can only work on one branch at a time and can open one pull request per task.\u003c/li\u003e\n\u003cli\u003e\u003cstrong\u003eSession duration\u003c/strong\u003e: Each Copilot session that runs on GitHub Actions has a maximum execution time of 59 minutes. This limit cannot be extended or bypassed. If a task exceeds the limit, the session stops. For environment configuration details, see \u003ca href=\"/en/copilot/how-tos/copilot-on-github/customize-copilot/customize-cloud-agent/customize-the-agent-environment\"\u003eConfigure the development environment for agents on GitHub Actions\u003c/a\u003e.\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003e\u003ca id=\"limitations-in-copilot-cloud-agents-compatibility-with-other-features\"\u003e\u003c/a\u003e\u003c/p\u003e\n\u003ch3 id=\"repository-compatibility\" tabindex=\"-1\"\u003e\u003ca class=\"heading-link\" href=\"#repository-compatibility\"\u003eRepository compatibility\u003cspan class=\"heading-link-symbol\" aria-hidden=\"true\"\u003e\u003c/span\u003e\u003c/a\u003e\u003c/h3\u003e\n\u003cul\u003e\n\u003cli\u003e\u003cstrong\u003eRepository rules\u003c/strong\u003e: A ruleset or branch protection rule can prevent Copilot from creating or updating pull requests. Repository administrators can configure a ruleset bypass for Copilot. See \u003ca href=\"/en/repositories/configuring-branches-and-merges-in-your-repository/managing-rulesets/creating-rulesets-for-a-repository#granting-bypass-permissions-for-your-branch-or-tag-ruleset\"\u003eCreating rulesets for a repository\u003c/a\u003e.\u003c/li\u003e\n\u003cli\u003e\u003cstrong\u003eRepository hosting\u003c/strong\u003e: Copilot only works with repositories hosted on GitHub. It cannot work on repositories stored on other code hosting platforms.\u003c/li\u003e\n\u003c/ul\u003e\n\u003ch2 id=\"the-older-experience\" tabindex=\"-1\"\u003e\u003ca class=\"heading-link\" href=\"#the-older-experience\"\u003eThe older experience\u003cspan class=\"heading-link-symbol\" aria-hidden=\"true\"\u003e\u003c/span\u003e\u003c/a\u003e\u003c/h2\u003e\n\u003cp\u003eThe newer Copilot in the cloud experience differs from the older Copilot cloud agent plus Copilot Chat experience in several key aspects, including default environments, policies, what session choices are available. Session context and customizations also differ.\u003c/p\u003e\n\u003ch3 id=\"comparison-of-the-two-experiences\" tabindex=\"-1\"\u003e\u003ca class=\"heading-link\" href=\"#comparison-of-the-two-experiences\"\u003eComparison of the two experiences\u003cspan class=\"heading-link-symbol\" aria-hidden=\"true\"\u003e\u003c/span\u003e\u003c/a\u003e\u003c/h3\u003e\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\u003ctable aria-labelledby=\"comparison-of-the-two-experiences\"\u003e\u003cthead\u003e\u003ctr\u003e\u003cth scope=\"col\"\u003e\u003c/th\u003e\u003cth scope=\"col\"\u003eCopilot cloud agent plus Copilot Chat experience\u003c/th\u003e\u003cth scope=\"col\"\u003eCopilot in the cloud\u003c/th\u003e\u003c/tr\u003e\u003c/thead\u003e\u003ctbody\u003e\u003ctr\u003e\u003ctd\u003e\u003cstrong\u003eDefault environment\u003c/strong\u003e\u003c/td\u003e\u003ctd\u003eAll web entry points for agents, including a repository's \u003cstrong\u003eAgents\u003c/strong\u003e tab, default to an GitHub Actions-based environment.\u003c/td\u003e\u003ctd\u003eCloud is the default where an environment choice is offered. Defaults can vary by workflow, so check the selected environment before starting.\u003c/td\u003e\u003c/tr\u003e\u003ctr\u003e\u003ctd\u003e\u003cstrong\u003ePolicies\u003c/strong\u003e\u003c/td\u003e\u003ctd\u003eSeparate policies for Copilot features such as cloud agent and Copilot Chat in GitHub.\u003c/td\u003e\u003ctd\u003eA single organization and enterprise policy for Copilot in the cloud on GitHub.com and GitHub Mobile.\u003c/td\u003e\u003c/tr\u003e\u003ctr\u003e\u003ctd\u003e\u003cstrong\u003eSession choice\u003c/strong\u003e\u003c/td\u003e\u003ctd\u003eChat conversations and delegated cloud agent tasks are separate sessions. Agent tasks started from Copilot Chat run in an GitHub Actions-based environment.\u003c/td\u003e\u003ctd\u003eYou can choose where the chat and agent session runs, either in a cloud sandbox or an GitHub Actions-based environment.\u003c/td\u003e\u003c/tr\u003e\u003c/tbody\u003e\u003c/table\u003e\n\u003ch3 id=\"session-context-1\" tabindex=\"-1\"\u003e\u003ca class=\"heading-link\" href=\"#session-context-1\"\u003eSession context\u003cspan class=\"heading-link-symbol\" aria-hidden=\"true\"\u003e\u003c/span\u003e\u003c/a\u003e\u003c/h3\u003e\n\u003cp\u003eYou can start a chat session with the following contexts automatically attached:\u003c/p\u003e\n\u003cul\u003e\n\u003cli\u003eA specific file, issue, pull request.\u003c/li\u003e\n\u003cli\u003eA specific repository and branch.\u003c/li\u003e\n\u003c/ul\u003e\n\u003cp\u003eYou cannot start a chat session with multiple repositories automatically attached.\u003c/p\u003e\n\u003cp\u003eTo start a conversation with the context of multiple repositories, manually select repositories owned by you or by an organization with repository selector.\u003c/p\u003e\n\u003cp\u003eYou can attach other session context with the \u003cstrong\u003e+\u003c/strong\u003e menu, or \u003cstrong\u003e@\u003c/strong\u003e mentions.\u003c/p\u003e\n\u003cp\u003eWhen starting a session from Copilot Chat, you can't choose an environment; your session runs on GitHub Actions automatically.\u003c/p\u003e\n\u003ch3 id=\"sessions-across-surfaces-1\" tabindex=\"-1\"\u003e\u003ca class=\"heading-link\" href=\"#sessions-across-surfaces-1\"\u003eSessions across surfaces\u003cspan class=\"heading-link-symbol\" aria-hidden=\"true\"\u003e\u003c/span\u003e\u003c/a\u003e\u003c/h3\u003e\n\u003cp\u003eSome context, permissions, and configuration can carry between surfaces. The settings and context that apply depend on the Copilot feature and the surface you use.\u003c/p\u003e\n\u003ch3 id=\"customizations\" tabindex=\"-1\"\u003e\u003ca class=\"heading-link\" href=\"#customizations\"\u003eCustomizations\u003cspan class=\"heading-link-symbol\" aria-hidden=\"true\"\u003e\u003c/span\u003e\u003c/a\u003e\u003c/h3\u003e\n\u003cp\u003eCustom instructions let you save personal preferences for chat, repository conventions, and organization guidance.\u003c/p\u003e\n\u003cp\u003eCopilot Spaces organize shared context for questions.\u003c/p\u003e\n\u003cp\u003eFor delegated work, custom agents and agent skills provide task-specific instructions and resources. Repository MCP servers connect agents to additional tools and data.\u003c/p\u003e\n\u003cp\u003eHooks can run commands during agent work for validation or logging.\u003c/p\u003e\n\u003ch2 id=\"further-reading\" tabindex=\"-1\"\u003e\u003ca class=\"heading-link\" href=\"#further-reading\"\u003eFurther reading\u003cspan class=\"heading-link-symbol\" aria-hidden=\"true\"\u003e\u003c/span\u003e\u003c/a\u003e\u003c/h2\u003e\n\u003cul\u003e\n\u003cli\u003e\u003ca href=\"/en/copilot/how-tos/copilot-on-github\"\u003eGitHub Copilot on GitHub\u003c/a\u003e\u003c/li\u003e\n\u003cli\u003e\u003ca href=\"/en/copilot/how-tos/use-copilot-agents/cloud-agent\"\u003eGitHub Copilot cloud agent\u003c/a\u003e how-to guides\u003c/li\u003e\n\u003cli\u003e\u003ca href=\"/en/copilot/tutorials/copilot-cookbook\"\u003eGitHub Copilot Cookbook\u003c/a\u003e\u003c/li\u003e\n\u003cli\u003eFor delegating work from tools such as Microsoft Teams and Slack, see \u003ca href=\"/en/copilot/concepts/agent-capabilities/choosing-and-delegating-agent-work/about-copilot-integrations\"\u003eCopilot integrations\u003c/a\u003e.\u003c/li\u003e\n\u003cli\u003eFor organization and enterprise metrics on pull request creation, merges, and time to merge, see \u003ca href=\"/en/copilot/concepts/billing-and-usage/copilot-usage-metrics/copilot-metrics\"\u003eGitHub Copilot usage metrics\u003c/a\u003e.\u003c/li\u003e\n\u003c/ul\u003e","renderedPageHast":{"type":"root","children":[{"type":"element","tagName":"p","properties":{},"children":[{"type":"text","value":"On the GitHub website and GitHub Mobile, GitHub Copilot can answer questions about your repositories, plan and make changes, review pull requests, and automate repository tasks. You can ask questions and delegate work from a conversation, and use Copilot directly in your issue and pull request workflows."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"text","value":"With the new "},{"type":"element","tagName":"strong","properties":{},"children":[{"type":"text","value":"Copilot in the cloud"}]},{"type":"text","value":" experience, you can move between web or mobile and local clients (Copilot app, VS Code, or Copilot CLI), working with and steering Copilot in the same session."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"div","properties":{"className":"ghd-alert ghd-alert-accent","dataContainer":"alert"},"children":[{"type":"element","tagName":"p","properties":{"className":["ghd-alert-title"]},"children":[{"type":"element","tagName":"svg","properties":{"version":"1.1","width":16,"height":16,"viewBox":"0 0 16 16","className":["octicon","mr-2"],"ariaHidden":true},"children":[{"type":"element","tagName":"path","properties":{"d":"M0 8a8 8 0 1 1 16 0A8 8 0 0 1 0 8Zm8-6.5a6.5 6.5 0 1 0 0 13 6.5 6.5 0 0 0 0-13ZM6.5 7.75A.75.75 0 0 1 7.25 7h1a.75.75 0 0 1 .75.75v2.75h.25a.75.75 0 0 1 0 1.5h-2a.75.75 0 0 1 0-1.5h.25v-2h-.25a.75.75 0 0 1-.75-.75ZM8 6a1 1 0 1 1 0-2 1 1 0 0 1 0 2Z"},"children":[]}]},{"type":"text","value":"Note"}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"text","value":"\nStarting October 28, 2026, the new Copilot in the cloud experience on GitHub.com and GitHub Mobile is available to users with a paid Copilot plan, subject to applicable organization and enterprise policies. Users on Copilot Free plans will continue to use the old Copilot Chat experience."}]},{"type":"text","value":"\n"}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"text","value":"This article explains both the newer Copilot in the cloud experience and the older Copilot cloud agent plus Copilot Chat experience. For a quick overview of what's changing, see "},{"type":"element","tagName":"a","properties":{"href":"#comparison-of-the-two-experiences"},"children":[{"type":"text","value":"Comparison of the two experiences"}]},{"type":"text","value":"."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"h2","properties":{"id":"how-copilot-helps-on-githubcom-and-github-mobile","tabIndex":-1},"children":[{"type":"element","tagName":"a","properties":{"className":["heading-link"],"href":"#how-copilot-helps-on-githubcom-and-github-mobile"},"children":[{"type":"text","value":"How Copilot helps on GitHub.com and GitHub Mobile"},{"type":"element","tagName":"span","properties":{"className":["heading-link-symbol"],"ariaHidden":"true"},"children":[]}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"text","value":"You can combine chat, agentic work, code review, and automations in your repository workflows."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"text","value":"For example, you might use chat to understand how a repository handles authentication, then ask Copilot to plan and add missing tests. Once the changes are in a pull request, you can request a review from Copilot. To maintain test coverage over time, you could set up an automation to check for missing tests each week and propose additions for you to review."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"h2","properties":{"id":"key-concepts-for-copilot-in-the-cloud","tabIndex":-1},"children":[{"type":"element","tagName":"a","properties":{"className":["heading-link"],"href":"#key-concepts-for-copilot-in-the-cloud"},"children":[{"type":"text","value":"Key concepts for Copilot in the cloud"},{"type":"element","tagName":"span","properties":{"className":["heading-link-symbol"],"ariaHidden":"true"},"children":[]}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"text","value":"Copilot in the cloud allows for a continuous task flow. Copilot sessions that you start on in a cloud environment on GitHub can continue seamlessly across different clients, such as the GitHub Copilot app, your IDE, mobile, and CLI. Your work and context are preserved across these clients, meaning you can move from asking questions to agentic work to task completion, in the same conversation."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"h3","properties":{"id":"client-session-and-environment","tabIndex":-1},"children":[{"type":"element","tagName":"a","properties":{"className":["heading-link"],"href":"#client-session-and-environment"},"children":[{"type":"text","value":"Client, session, and environment"},{"type":"element","tagName":"span","properties":{"className":["heading-link-symbol"],"ariaHidden":"true"},"children":[]}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"text","value":"There are three key components to understand in the task flow: the client, the session, and the environment."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"text","value":"To start an agent task, you interact with Copilot through a client or surface, such as the web interface, GitHub Copilot app, IDE, GitHub Mobile, or GitHub Copilot CLI."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"text","value":"A session is the conversation and activity associated with agentic work, including the prompts you provide and the responses generated by Copilot."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"text","value":"An environment is the place where the agent executes its work, such as a cloud sandbox, a GitHub Actions runner, or a remote custom environment."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"text","value":"For more information, see "},{"type":"element","tagName":"a","properties":{"href":"/en/copilot/concepts/security-governance-and-network-settings/about-cloud-sandboxes"},"children":[{"type":"text","value":"About cloud sandboxes for GitHub Copilot"}]},{"type":"text","value":", "},{"type":"element","tagName":"a","properties":{"href":"/en/copilot/concepts/security-governance-and-network-settings/about-cloud-and-local-sandboxes"},"children":[{"type":"text","value":"About local sandboxing for GitHub Copilot"}]},{"type":"text","value":", and "},{"type":"element","tagName":"a","properties":{"href":"/en/copilot/concepts/copilot-surfaces/copilot-in-ides"},"children":[{"type":"text","value":"GitHub Copilot in IDEs"}]},{"type":"text","value":"."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"h3","properties":{"id":"session-context","tabIndex":-1},"children":[{"type":"element","tagName":"a","properties":{"className":["heading-link"],"href":"#session-context"},"children":[{"type":"text","value":"Session context"},{"type":"element","tagName":"span","properties":{"className":["heading-link-symbol"],"ariaHidden":"true"},"children":[]}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"text","value":"You can start a chat session with the following contexts automatically attached:"}]},{"type":"text","value":"\n"},{"type":"element","tagName":"ul","properties":{},"children":[{"type":"text","value":"\n"},{"type":"element","tagName":"li","properties":{},"children":[{"type":"text","value":"All repositories, owned by you or by an organization."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"li","properties":{},"children":[{"type":"text","value":"A specific file, issue, pull request."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"li","properties":{},"children":[{"type":"text","value":"A specific repository and branch."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"li","properties":{},"children":[{"type":"text","value":"A space."}]},{"type":"text","value":"\n"}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"text","value":"You can attach context with the repository selector, the "},{"type":"element","tagName":"strong","properties":{},"children":[{"type":"text","value":"+"}]},{"type":"text","value":" menu, or "},{"type":"element","tagName":"strong","properties":{},"children":[{"type":"text","value":"@"}]},{"type":"text","value":" mentions."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"text","value":"To let Copilot retrieve information from supported services during a task, use customizations such as Copilot connectors and personal custom Model Context Protocol (MCP) servers."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"text","value":"Session context is distinct from Copilot Memory, which builds a longer-term, persistent understanding of your repositories and preferences across sessions. For more information, see "},{"type":"element","tagName":"a","properties":{"href":"/en/copilot/concepts/prompting-and-context/copilot-memory"},"children":[{"type":"text","value":"About GitHub Copilot Memory"}]},{"type":"text","value":"."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"h3","properties":{"id":"sessions-across-surfaces","tabIndex":-1},"children":[{"type":"element","tagName":"a","properties":{"className":["heading-link"],"href":"#sessions-across-surfaces"},"children":[{"type":"text","value":"Sessions across surfaces"},{"type":"element","tagName":"span","properties":{"className":["heading-link-symbol"],"ariaHidden":"true"},"children":[]}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"text","value":"Choose a cloud sandbox when you want to continue a session across supported Copilot surfaces. You can start a cloud session on one surface and continue it on another."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"h3","properties":{"id":"comparison-of-github-actions-based-sessions-and-cloud-sandboxes","tabIndex":-1},"children":[{"type":"element","tagName":"a","properties":{"className":["heading-link"],"href":"#comparison-of-github-actions-based-sessions-and-cloud-sandboxes"},"children":[{"type":"text","value":"Comparison of GitHub Actions-based sessions and cloud sandboxes"},{"type":"element","tagName":"span","properties":{"className":["heading-link-symbol"],"ariaHidden":"true"},"children":[]}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"text","value":"In Copilot in the cloud, you have three environment choices: Cloud (a cloud sandbox), GitHub Actions-based, and Remote (a connection to a custom environment)."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"text","value":"Initial performance testing on GitHub indicates that sessions in cloud sandboxes completed execution faster on average than GitHub Actions-based sessions."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"text","value":"The following table compares GitHub Actions-based sessions and cloud sandbox-based sessions."}]},{"type":"text","value":"\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n"},{"type":"element","tagName":"table","properties":{"ariaLabelledBy":"comparison-of-github-actions-based-sessions-and-cloud-sandboxes"},"children":[{"type":"element","tagName":"thead","properties":{},"children":[{"type":"element","tagName":"tr","properties":{},"children":[{"type":"element","tagName":"th","properties":{"scope":"col"},"children":[]},{"type":"element","tagName":"th","properties":{"scope":"col"},"children":[{"type":"text","value":"GitHub Actions"}]},{"type":"element","tagName":"th","properties":{"scope":"col"},"children":[{"type":"text","value":"Cloud sandbox"}]}]}]},{"type":"element","tagName":"tbody","properties":{},"children":[{"type":"element","tagName":"tr","properties":{},"children":[{"type":"element","tagName":"td","properties":{},"children":[{"type":"element","tagName":"strong","properties":{},"children":[{"type":"text","value":"Session continuity"}]}]},{"type":"element","tagName":"td","properties":{},"children":[{"type":"text","value":"Sessions are only available on the GitHub website."}]},{"type":"element","tagName":"td","properties":{},"children":[{"type":"text","value":"Sessions can be shared and resumed across clients."}]}]},{"type":"element","tagName":"tr","properties":{},"children":[{"type":"element","tagName":"td","properties":{},"children":[{"type":"element","tagName":"strong","properties":{},"children":[{"type":"text","value":"Repository scoping"}]}]},{"type":"element","tagName":"td","properties":{},"children":[{"type":"text","value":"Sessions require a repository. Changes are made only in the specific, single repository context."}]},{"type":"element","tagName":"td","properties":{},"children":[{"type":"text","value":"Sessions can span across repositories in one organization. Changes can be made across multiple repositories"}]}]},{"type":"element","tagName":"tr","properties":{},"children":[{"type":"element","tagName":"td","properties":{},"children":[{"type":"element","tagName":"strong","properties":{},"children":[{"type":"text","value":"Chat data retention"}]}]},{"type":"element","tagName":"td","properties":{},"children":[{"type":"text","value":"Data is retained for 28 days."}]},{"type":"element","tagName":"td","properties":{},"children":[{"type":"text","value":"Data is retained for the life of the account."}]}]},{"type":"element","tagName":"tr","properties":{},"children":[{"type":"element","tagName":"td","properties":{},"children":[{"type":"element","tagName":"strong","properties":{},"children":[{"type":"text","value":"Custom environments"}]}]},{"type":"element","tagName":"td","properties":{},"children":[{"type":"text","value":"Supports GitHub Actions-specific custom compute, network and setup configuration, and self-hosted runners."}]},{"type":"element","tagName":"td","properties":{},"children":[{"type":"text","value":"Cloud sandboxes honor repository and organization firewall allowlists, but do not support custom compute, GitHub Actions-specific setup steps, or self-hosted runners."}]}]},{"type":"element","tagName":"tr","properties":{},"children":[{"type":"element","tagName":"td","properties":{},"children":[{"type":"element","tagName":"strong","properties":{},"children":[{"type":"text","value":"Customizations and tool sharing"}]}]},{"type":"element","tagName":"td","properties":{},"children":[{"type":"text","value":"Supports custom instructions, MCP servers, and content exclusions."}]},{"type":"element","tagName":"td","properties":{},"children":[{"type":"text","value":"Supports custom instructions, dotfiles personalization, repository and personal MCP servers, connectors, and content exclusions with a single configuration across all cloud sandboxes."}]}]},{"type":"element","tagName":"tr","properties":{},"children":[{"type":"element","tagName":"td","properties":{},"children":[{"type":"element","tagName":"strong","properties":{},"children":[{"type":"text","value":"Why choose this environment"}]}]},{"type":"element","tagName":"td","properties":{},"children":[{"type":"text","value":"Suitable when you need repository-specific integrations, custom environments, or self-hosted runners."}]},{"type":"element","tagName":"td","properties":{},"children":[{"type":"text","value":"Suitable for cross-repository chat, quick access to AI models, and when custom compute or network configurations are not required in cloud sandboxes."}]}]}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"text","value":"In the Copilot in the cloud experience, cloud and GitHub Actions compute draw on the same monthly GitHub account allowance, separate from AI credits. For details, see "},{"type":"element","tagName":"a","properties":{"href":"/en/billing/concepts/product-billing/cloud-and-local-sandboxes"},"children":[{"type":"text","value":"Billing for cloud and local sandboxes for GitHub Copilot"}]},{"type":"text","value":"."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"h2","properties":{"id":"access-and-availability","tabIndex":-1},"children":[{"type":"element","tagName":"a","properties":{"className":["heading-link"],"href":"#access-and-availability"},"children":[{"type":"text","value":"Access and availability"},{"type":"element","tagName":"span","properties":{"className":["heading-link-symbol"],"ariaHidden":"true"},"children":[]}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"text","value":"Available Copilot features depend on your plan and organization policies. For setup guidance, see "},{"type":"element","tagName":"a","properties":{"href":"/en/copilot/how-tos/copilot-on-github/set-up-copilot"},"children":[{"type":"text","value":"Set up Copilot"}]},{"type":"text","value":". For usage allowances and costs, see "},{"type":"element","tagName":"a","properties":{"href":"/en/copilot/concepts/billing-and-usage"},"children":[{"type":"text","value":"GitHub Copilot billing and usage"}]},{"type":"text","value":"."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"text","value":"Repository owners and administrators can disable Copilot for particular repositories, even when your plan and policies otherwise allow you to use it. Organization and enterprise policies continue to apply. See "},{"type":"element","tagName":"a","properties":{"href":"/en/copilot/concepts/enterprise/cloud-agent-access"},"children":[{"type":"text","value":"Managing GitHub Copilot in the cloud for your enterprise or organization"}]},{"type":"text","value":"."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"text","value":"To view organization data or sessions, you must meet your organization's single sign-on requirements."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"text","value":"Without write access to a repository, your Copilot session is read-only."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"h2","properties":{"id":"starting-with-copilot-on-githubcom-and-github-mobile","tabIndex":-1},"children":[{"type":"element","tagName":"a","properties":{"className":["heading-link"],"href":"#starting-with-copilot-on-githubcom-and-github-mobile"},"children":[{"type":"text","value":"Starting with Copilot on GitHub.com and GitHub Mobile"},{"type":"element","tagName":"span","properties":{"className":["heading-link-symbol"],"ariaHidden":"true"},"children":[]}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"text","value":"You can start working with Copilot from several different entry points:"}]},{"type":"text","value":"\n"},{"type":"element","tagName":"ul","properties":{},"children":[{"type":"text","value":"\n"},{"type":"element","tagName":"li","properties":{},"children":[{"type":"text","value":"Your Copilot home page at "},{"type":"element","tagName":"a","properties":{"href":"https://github.com/copilot?ref_product=copilot\u0026ref_type=engagement\u0026ref_style=text\u0026utm_source=dotcom-surface-doc-home\u0026utm_medium=docs\u0026utm_campaign=universe-2026"},"children":[{"type":"text","value":"github.com/copilot"}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"li","properties":{},"children":[{"type":"text","value":"The Copilot panel, displayed when starting a session within a file, issue, or pull request"}]},{"type":"text","value":"\n"},{"type":"element","tagName":"li","properties":{},"children":[{"type":"text","value":"Your GitHub dashboard at "},{"type":"element","tagName":"a","properties":{"href":"https://github.com?ref_product=copilot\u0026ref_type=engagement\u0026ref_style=text\u0026utm_source=dotcom-surface-concept-doc\u0026utm_medium=docs\u0026utm_campaign=universe-2026"},"children":[{"type":"text","value":"github.com"}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"li","properties":{},"children":[{"type":"text","value":"The "},{"type":"element","tagName":"strong","properties":{},"children":[{"type":"text","value":"Agents"}]},{"type":"text","value":" tab or panel within a repository"}]},{"type":"text","value":"\n"}]},{"type":"text","value":"\n"},{"type":"element","tagName":"h2","properties":{"id":"ways-to-work-with-copilot","tabIndex":-1},"children":[{"type":"element","tagName":"a","properties":{"className":["heading-link"],"href":"#ways-to-work-with-copilot"},"children":[{"type":"text","value":"Ways to work with Copilot"},{"type":"element","tagName":"span","properties":{"className":["heading-link-symbol"],"ariaHidden":"true"},"children":[]}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"text","value":"You can work with Copilot in several ways:"}]},{"type":"text","value":"\n"},{"type":"element","tagName":"h3","properties":{"id":"asking-questions","tabIndex":-1},"children":[{"type":"element","tagName":"a","properties":{"className":["heading-link"],"href":"#asking-questions"},"children":[{"type":"text","value":"Asking questions"},{"type":"element","tagName":"span","properties":{"className":["heading-link-symbol"],"ariaHidden":"true"},"children":[]}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"text","value":"Chat can explain unfamiliar code, suggest fixes, generate tests, or compare approaches. Follow-up questions let you refine your request without starting a new conversation."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"text","value":"Chat is preconfigured with tools for tasks such as creating branches, updating files, and creating or updating issues. It also supports semantic code search, limited to default branches only."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"h3","properties":{"id":"agentic-work","tabIndex":-1},"children":[{"type":"element","tagName":"a","properties":{"className":["heading-link"],"href":"#agentic-work"},"children":[{"type":"text","value":"Agentic work"},{"type":"element","tagName":"span","properties":{"className":["heading-link-symbol"],"ariaHidden":"true"},"children":[]}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"text","value":"Copilot can research a repository, plan changes, and implement them in the background. It can edit files and run tests and linters in a cloud development environment, rather than your local IDE."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"text","value":"When you ask for changes, Copilot works against the repository and branch you provided. You can review the proposed changes and ask for refinements before creating a pull request, or request a pull request in your prompt."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"text","value":"From security campaigns, you can assign code scanning alerts to Copilot for fixes. See "},{"type":"element","tagName":"a","properties":{"href":"/en/code-security/how-tos/manage-security-alerts/remediate-alerts-at-scale/fixing-alerts-in-security-campaign#assigning-alerts-to-copilot"},"children":[{"type":"text","value":"Fixing alerts in a security campaign"}]},{"type":"text","value":"."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"h3","properties":{"id":"code-review","tabIndex":-1},"children":[{"type":"element","tagName":"a","properties":{"className":["heading-link"],"href":"#code-review"},"children":[{"type":"text","value":"Code review"},{"type":"element","tagName":"span","properties":{"className":["heading-link-symbol"],"ariaHidden":"true"},"children":[]}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"text","value":"On GitHub, Copilot code review reviews pull request changes, identifies potential issues, and suggests fixes. It uses agentic capabilities to gather context from your repository. You can request a review or configure automatic reviews, then review and apply the suggested changes. See "},{"type":"element","tagName":"a","properties":{"href":"/en/copilot/concepts/agent-capabilities/agent-powered-workflows-and-operations/code-review"},"children":[{"type":"text","value":"GitHub Copilot code review"}]},{"type":"text","value":"."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"text","value":"Copilot can also generate a summary of your changes directly in a pull request description or comment. This helps reviewers understand the changes, but is separate from reviewing the code. See "},{"type":"element","tagName":"a","properties":{"href":"/en/copilot/how-tos/copilot-on-github/copilot-for-github-tasks/create-a-pr-summary"},"children":[{"type":"text","value":"Creating a pull request summary with GitHub Copilot"}]},{"type":"text","value":"."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"h3","properties":{"id":"getting-pull-requests-ready-to-merge","tabIndex":-1},"children":[{"type":"element","tagName":"a","properties":{"className":["heading-link"],"href":"#getting-pull-requests-ready-to-merge"},"children":[{"type":"text","value":"Getting pull requests ready to merge"},{"type":"element","tagName":"span","properties":{"className":["heading-link-symbol"],"ariaHidden":"true"},"children":[]}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"text","value":"With Agent Merge, Copilot watches a pull request and works on the blockers you select: failed GitHub Actions workflows, merge conflicts, or both. Enable it with "},{"type":"element","tagName":"strong","properties":{},"children":[{"type":"text","value":"Watch and fix"}]},{"type":"text","value":" in the pull request's merge box. You can also enable it automatically for pull requests you create. See "},{"type":"element","tagName":"a","properties":{"href":"/en/copilot/how-tos/copilot-on-github/use-copilot-agents/get-pull-requests-ready-to-merge"},"children":[{"type":"text","value":"Getting pull requests ready to merge with Agent Merge"}]},{"type":"text","value":"."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"h3","properties":{"id":"automations-and-agentic-workflows","tabIndex":-1},"children":[{"type":"element","tagName":"a","properties":{"className":["heading-link"],"href":"#automations-and-agentic-workflows"},"children":[{"type":"text","value":"Automations and agentic workflows"},{"type":"element","tagName":"span","properties":{"className":["heading-link-symbol"],"ariaHidden":"true"},"children":[]}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"text","value":"Automations let you define a task once and have Copilot run it on a schedule or in response to repository events. For example, an automation can triage issues or prepare weekly release notes. You create and manage automations from the "},{"type":"element","tagName":"strong","properties":{},"children":[{"type":"text","value":"Agents"}]},{"type":"text","value":" tab in a repository on GitHub.com. Automations are available in eligible private and internal repositories. See "},{"type":"element","tagName":"a","properties":{"href":"/en/copilot/concepts/agent-capabilities/agent-powered-workflows-and-operations/about-automations"},"children":[{"type":"text","value":"Copilot automations"}]},{"type":"text","value":"."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"text","value":"GitHub Agentic Workflows provide another way to automate tasks in your repositories on GitHub.com. You define tasks in natural language in Markdown files, and they run as GitHub Actions workflows. These workflows can use Copilot or another supported coding agent. See "},{"type":"element","tagName":"a","properties":{"href":"/en/copilot/concepts/agent-capabilities/agent-powered-workflows-and-operations/about-github-agentic-workflows"},"children":[{"type":"text","value":"GitHub Agentic Workflows"}]},{"type":"text","value":"."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"h2","properties":{"id":"session-history-and-remote-control","tabIndex":-1},"children":[{"type":"element","tagName":"a","properties":{"className":["heading-link"],"href":"#session-history-and-remote-control"},"children":[{"type":"text","value":"Session history and remote control"},{"type":"element","tagName":"span","properties":{"className":["heading-link-symbol"],"ariaHidden":"true"},"children":[]}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"text","value":"On GitHub, session logs show the work and tools used. Shared sessions and pull requests let teammates with repository access follow the work and review changes. Logs do not replace your own review and testing. See "},{"type":"element","tagName":"a","properties":{"href":"/en/copilot/how-tos/copilot-on-github/use-copilot-agents/manage-and-track-agents"},"children":[{"type":"text","value":"Managing agent sessions"}]},{"type":"text","value":"."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"text","value":"To monitor and steer a session started from GitHub Copilot CLI, enable remote control. The session continues running on your original local machine, which must stay online. See "},{"type":"element","tagName":"a","properties":{"href":"/en/copilot/concepts/agent-capabilities/agent-powered-workflows-and-operations/about-remote-control"},"children":[{"type":"text","value":"Remote control of GitHub Copilot CLI sessions"}]},{"type":"text","value":"."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"text","value":"You can ask Copilot about your synced session history across Copilot surfaces. This includes Copilot in the cloud and Copilot code review sessions, and sessions from GitHub Copilot CLI, VS Code, JetBrains IDEs, and the GitHub Copilot app."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"text","value":"You can only query sessions you started. Syncing must be enabled and permitted by your organization's policies. See "},{"type":"element","tagName":"a","properties":{"href":"/en/copilot/how-tos/copilot-on-github/use-copilot-agents/manage-and-track-agents#query-past-sessions"},"children":[{"type":"text","value":"Query past sessions"}]},{"type":"text","value":"."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"h2","properties":{"id":"customize-your-experience","tabIndex":-1},"children":[{"type":"element","tagName":"a","properties":{"className":["heading-link"],"href":"#customize-your-experience"},"children":[{"type":"text","value":"Customize your experience"},{"type":"element","tagName":"span","properties":{"className":["heading-link-symbol"],"ariaHidden":"true"},"children":[]}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"text","value":"There are several ways to customize your experience with Copilot."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"h3","properties":{"id":"instructions-tools-and-shared-context","tabIndex":-1},"children":[{"type":"element","tagName":"a","properties":{"className":["heading-link"],"href":"#instructions-tools-and-shared-context"},"children":[{"type":"text","value":"Instructions, tools, and shared context"},{"type":"element","tagName":"span","properties":{"className":["heading-link-symbol"],"ariaHidden":"true"},"children":[]}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"text","value":"On GitHub, custom instructions let you save personal preferences for chat, repository conventions, and organization guidance."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"text","value":"Copilot Spaces organize shared context for questions."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"text","value":"For delegated work, custom agents and agent skills provide task-specific instructions and resources. MCP servers connect agents to additional tools and data."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"text","value":"Hooks can run commands during agent work for validation or logging. For setup guidance, see "},{"type":"element","tagName":"a","properties":{"href":"/en/copilot/how-tos/copilot-on-github/customize-copilot"},"children":[{"type":"text","value":"Customize Copilot"}]},{"type":"text","value":"."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"h3","properties":{"id":"customizations-for-copilot-in-the-cloud","tabIndex":-1},"children":[{"type":"element","tagName":"a","properties":{"className":["heading-link"],"href":"#customizations-for-copilot-in-the-cloud"},"children":[{"type":"text","value":"Customizations for Copilot in the cloud"},{"type":"element","tagName":"span","properties":{"className":["heading-link-symbol"],"ariaHidden":"true"},"children":[]}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"text","value":"In cloud sandboxes, you can also use a dotfiles repository to bring your personal instructions, skills, and custom agents to your sessions across repositories. This dotfiles personalization does not apply to GitHub Actions-based sessions. For setup guidance, see "},{"type":"element","tagName":"a","properties":{"href":"/en/copilot/how-tos/copilot-on-github/customize-copilot/customize-cloud-agent/personalize-cloud-sessions"},"children":[{"type":"text","value":"Personalizing your cloud sessions"}]},{"type":"text","value":"."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"text","value":"To bring tools and context into Copilot, you can access third-party services through GitHub connectors. Connectors are available to all your Copilot in the cloud sessions. You can also configure personal MCP server configurations to allow Copilot access to your personal tools and context. These customizations do not apply to GitHub Actions-based sessions. See "},{"type":"element","tagName":"a","properties":{"href":"/en/copilot/concepts/customizations/copilot-connectors"},"children":[{"type":"text","value":"Copilot connectors"}]},{"type":"text","value":" and "},{"type":"element","tagName":"a","properties":{"href":"/en/copilot/concepts/customizations/mcp"},"children":[{"type":"text","value":"Model Context Protocol (MCP)"}]},{"type":"text","value":"."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"text","value":"Some existing Spaces that include data from multiple organizations or mix private and organization data may not work the same way in Copilot in the cloud. For steps to restore chat use in Spaces containing incompatible private sources, see "},{"type":"element","tagName":"a","properties":{"href":"/en/copilot/how-tos/copilot-on-github/customize-copilot/copilot-spaces/create-copilot-spaces#restoring-chat-use-in-spaces-with-incompatible-private-sources"},"children":[{"type":"text","value":"Creating GitHub Copilot Spaces"}]},{"type":"text","value":"."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"h3","properties":{"id":"ai-models","tabIndex":-1},"children":[{"type":"element","tagName":"a","properties":{"className":["heading-link"],"href":"#ai-models"},"children":[{"type":"text","value":"AI models"},{"type":"element","tagName":"span","properties":{"className":["heading-link-symbol"],"ariaHidden":"true"},"children":[]}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"text","value":"You can change the model Copilot uses to generate responses. You may find that different models perform better, or provide more useful responses, depending on the type of questions you ask. Options include premium models with advanced capabilities. To change the model in your IDE, see "},{"type":"element","tagName":"a","properties":{"href":"/en/copilot/how-tos/copilot-in-your-ide/chat-with-copilot/change-the-chat-model"},"children":[{"type":"text","value":"Changing the AI model for GitHub Copilot Chat"}]},{"type":"text","value":". To change or compare models on GitHub, see "},{"type":"element","tagName":"a","properties":{"href":"/en/copilot/how-tos/copilot-on-github/chat-with-copilot/chat-in-github#changing-and-comparing-ai-models"},"children":[{"type":"text","value":"Asking GitHub Copilot questions in GitHub"}]},{"type":"text","value":"."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"text","value":"On GitHub.com and GitHub Mobile, available models depend on your plan and account policies. See "},{"type":"element","tagName":"a","properties":{"href":"/en/copilot/reference/ai-models/supported-models"},"children":[{"type":"text","value":"Supported AI models in GitHub Copilot"}]},{"type":"text","value":"."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"text","value":"For Copilot in the cloud, the ability to select a model also depends on how you start the task. See "},{"type":"element","tagName":"a","properties":{"href":"/en/copilot/how-tos/use-copilot-agents/cloud-agent/changing-the-ai-model"},"children":[{"type":"text","value":"Changing the AI model for GitHub Copilot cloud agent"}]},{"type":"text","value":"."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"h2","properties":{"id":"copilot-limitations-and-compatibility","tabIndex":-1},"children":[{"type":"element","tagName":"a","properties":{"className":["heading-link"],"href":"#copilot-limitations-and-compatibility"},"children":[{"type":"text","value":"Copilot limitations and compatibility"},{"type":"element","tagName":"span","properties":{"className":["heading-link-symbol"],"ariaHidden":"true"},"children":[]}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"text","value":"Copilot can produce incorrect or suboptimal code, including code that contains security vulnerabilities. Review and test the output before using it in production. See "},{"type":"element","tagName":"a","properties":{"href":"/en/copilot/responsible-use/agents"},"children":[{"type":"text","value":"Application card: GitHub Copilot Agents"}]},{"type":"text","value":"."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"text","value":"For information about built-in security protections, see "},{"type":"element","tagName":"a","properties":{"href":"/en/copilot/concepts/security-governance-and-network-settings/risks-and-mitigations"},"children":[{"type":"text","value":"Risks and mitigations for GitHub Copilot cloud agent"}]},{"type":"text","value":"."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"h3","properties":{"id":"copilot-work-limitations","tabIndex":-1},"children":[{"type":"element","tagName":"a","properties":{"className":["heading-link"],"href":"#copilot-work-limitations"},"children":[{"type":"text","value":"Copilot work limitations"},{"type":"element","tagName":"span","properties":{"className":["heading-link-symbol"],"ariaHidden":"true"},"children":[]}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"ul","properties":{},"children":[{"type":"text","value":"\n"},{"type":"element","tagName":"li","properties":{},"children":[{"type":"element","tagName":"strong","properties":{},"children":[{"type":"text","value":"Repository scope"}]},{"type":"text","value":": When Copilot runs on GitHub Actions, Copilot can only make changes in the repository specified when you start a task. It cannot make changes across multiple repositories in one run. However, sessions that run in a cloud sandbox "},{"type":"element","tagName":"em","properties":{},"children":[{"type":"text","value":"can"}]},{"type":"text","value":" work across multiple repositories."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"li","properties":{},"children":[{"type":"element","tagName":"strong","properties":{},"children":[{"type":"text","value":"Context access"}]},{"type":"text","value":": In GitHub Actions-based sessions, the GitHub MCP server only provides access by default to context in the repository where the agent is working, such as issues and previous pull requests. You can configure broader access through repository MCP settings. See "},{"type":"element","tagName":"a","properties":{"href":"/en/copilot/how-tos/copilot-on-github/customize-copilot/configure-mcp-servers"},"children":[{"type":"text","value":"Configure MCP servers for your repository"}]},{"type":"text","value":". For sessions in cloud sandboxes, you can give additional context by configuring access to third-party services through GitHub connectors and personal custom MCP servers, see "},{"type":"element","tagName":"a","properties":{"href":"/en/copilot/concepts/customizations/copilot-connectors"},"children":[{"type":"text","value":"Copilot connectors"}]},{"type":"text","value":" and "},{"type":"element","tagName":"a","properties":{"href":"/en/copilot/concepts/customizations/mcp#personal-mcp-servers"},"children":[{"type":"text","value":"Model Context Protocol (MCP)"}]},{"type":"text","value":"."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"li","properties":{},"children":[{"type":"element","tagName":"strong","properties":{},"children":[{"type":"text","value":"Branches and pull requests"}]},{"type":"text","value":": In GitHub Actions-based sessions and cloud sandbox sessions, Copilot can only work on one branch at a time and can open one pull request per task."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"li","properties":{},"children":[{"type":"element","tagName":"strong","properties":{},"children":[{"type":"text","value":"Session duration"}]},{"type":"text","value":": Each Copilot session that runs on GitHub Actions has a maximum execution time of 59 minutes. This limit cannot be extended or bypassed. If a task exceeds the limit, the session stops. For environment configuration details, see "},{"type":"element","tagName":"a","properties":{"href":"/en/copilot/how-tos/copilot-on-github/customize-copilot/customize-cloud-agent/customize-the-agent-environment"},"children":[{"type":"text","value":"Configure the development environment for agents on GitHub Actions"}]},{"type":"text","value":"."}]},{"type":"text","value":"\n"}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"element","tagName":"a","properties":{"id":"limitations-in-copilot-cloud-agents-compatibility-with-other-features"},"children":[]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"h3","properties":{"id":"repository-compatibility","tabIndex":-1},"children":[{"type":"element","tagName":"a","properties":{"className":["heading-link"],"href":"#repository-compatibility"},"children":[{"type":"text","value":"Repository compatibility"},{"type":"element","tagName":"span","properties":{"className":["heading-link-symbol"],"ariaHidden":"true"},"children":[]}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"ul","properties":{},"children":[{"type":"text","value":"\n"},{"type":"element","tagName":"li","properties":{},"children":[{"type":"element","tagName":"strong","properties":{},"children":[{"type":"text","value":"Repository rules"}]},{"type":"text","value":": A ruleset or branch protection rule can prevent Copilot from creating or updating pull requests. Repository administrators can configure a ruleset bypass for Copilot. See "},{"type":"element","tagName":"a","properties":{"href":"/en/repositories/configuring-branches-and-merges-in-your-repository/managing-rulesets/creating-rulesets-for-a-repository#granting-bypass-permissions-for-your-branch-or-tag-ruleset"},"children":[{"type":"text","value":"Creating rulesets for a repository"}]},{"type":"text","value":"."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"li","properties":{},"children":[{"type":"element","tagName":"strong","properties":{},"children":[{"type":"text","value":"Repository hosting"}]},{"type":"text","value":": Copilot only works with repositories hosted on GitHub. It cannot work on repositories stored on other code hosting platforms."}]},{"type":"text","value":"\n"}]},{"type":"text","value":"\n"},{"type":"element","tagName":"h2","properties":{"id":"the-older-experience","tabIndex":-1},"children":[{"type":"element","tagName":"a","properties":{"className":["heading-link"],"href":"#the-older-experience"},"children":[{"type":"text","value":"The older experience"},{"type":"element","tagName":"span","properties":{"className":["heading-link-symbol"],"ariaHidden":"true"},"children":[]}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"text","value":"The newer Copilot in the cloud experience differs from the older Copilot cloud agent plus Copilot Chat experience in several key aspects, including default environments, policies, what session choices are available. Session context and customizations also differ."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"h3","properties":{"id":"comparison-of-the-two-experiences","tabIndex":-1},"children":[{"type":"element","tagName":"a","properties":{"className":["heading-link"],"href":"#comparison-of-the-two-experiences"},"children":[{"type":"text","value":"Comparison of the two experiences"},{"type":"element","tagName":"span","properties":{"className":["heading-link-symbol"],"ariaHidden":"true"},"children":[]}]}]},{"type":"text","value":"\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n"},{"type":"element","tagName":"table","properties":{"ariaLabelledBy":"comparison-of-the-two-experiences"},"children":[{"type":"element","tagName":"thead","properties":{},"children":[{"type":"element","tagName":"tr","properties":{},"children":[{"type":"element","tagName":"th","properties":{"scope":"col"},"children":[]},{"type":"element","tagName":"th","properties":{"scope":"col"},"children":[{"type":"text","value":"Copilot cloud agent plus Copilot Chat experience"}]},{"type":"element","tagName":"th","properties":{"scope":"col"},"children":[{"type":"text","value":"Copilot in the cloud"}]}]}]},{"type":"element","tagName":"tbody","properties":{},"children":[{"type":"element","tagName":"tr","properties":{},"children":[{"type":"element","tagName":"td","properties":{},"children":[{"type":"element","tagName":"strong","properties":{},"children":[{"type":"text","value":"Default environment"}]}]},{"type":"element","tagName":"td","properties":{},"children":[{"type":"text","value":"All web entry points for agents, including a repository's "},{"type":"element","tagName":"strong","properties":{},"children":[{"type":"text","value":"Agents"}]},{"type":"text","value":" tab, default to an GitHub Actions-based environment."}]},{"type":"element","tagName":"td","properties":{},"children":[{"type":"text","value":"Cloud is the default where an environment choice is offered. Defaults can vary by workflow, so check the selected environment before starting."}]}]},{"type":"element","tagName":"tr","properties":{},"children":[{"type":"element","tagName":"td","properties":{},"children":[{"type":"element","tagName":"strong","properties":{},"children":[{"type":"text","value":"Policies"}]}]},{"type":"element","tagName":"td","properties":{},"children":[{"type":"text","value":"Separate policies for Copilot features such as cloud agent and Copilot Chat in GitHub."}]},{"type":"element","tagName":"td","properties":{},"children":[{"type":"text","value":"A single organization and enterprise policy for Copilot in the cloud on GitHub.com and GitHub Mobile."}]}]},{"type":"element","tagName":"tr","properties":{},"children":[{"type":"element","tagName":"td","properties":{},"children":[{"type":"element","tagName":"strong","properties":{},"children":[{"type":"text","value":"Session choice"}]}]},{"type":"element","tagName":"td","properties":{},"children":[{"type":"text","value":"Chat conversations and delegated cloud agent tasks are separate sessions. Agent tasks started from Copilot Chat run in an GitHub Actions-based environment."}]},{"type":"element","tagName":"td","properties":{},"children":[{"type":"text","value":"You can choose where the chat and agent session runs, either in a cloud sandbox or an GitHub Actions-based environment."}]}]}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"h3","properties":{"id":"session-context-1","tabIndex":-1},"children":[{"type":"element","tagName":"a","properties":{"className":["heading-link"],"href":"#session-context-1"},"children":[{"type":"text","value":"Session context"},{"type":"element","tagName":"span","properties":{"className":["heading-link-symbol"],"ariaHidden":"true"},"children":[]}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"text","value":"You can start a chat session with the following contexts automatically attached:"}]},{"type":"text","value":"\n"},{"type":"element","tagName":"ul","properties":{},"children":[{"type":"text","value":"\n"},{"type":"element","tagName":"li","properties":{},"children":[{"type":"text","value":"A specific file, issue, pull request."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"li","properties":{},"children":[{"type":"text","value":"A specific repository and branch."}]},{"type":"text","value":"\n"}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"text","value":"You cannot start a chat session with multiple repositories automatically attached."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"text","value":"To start a conversation with the context of multiple repositories, manually select repositories owned by you or by an organization with repository selector."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"text","value":"You can attach other session context with the "},{"type":"element","tagName":"strong","properties":{},"children":[{"type":"text","value":"+"}]},{"type":"text","value":" menu, or "},{"type":"element","tagName":"strong","properties":{},"children":[{"type":"text","value":"@"}]},{"type":"text","value":" mentions."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"text","value":"When starting a session from Copilot Chat, you can't choose an environment; your session runs on GitHub Actions automatically."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"h3","properties":{"id":"sessions-across-surfaces-1","tabIndex":-1},"children":[{"type":"element","tagName":"a","properties":{"className":["heading-link"],"href":"#sessions-across-surfaces-1"},"children":[{"type":"text","value":"Sessions across surfaces"},{"type":"element","tagName":"span","properties":{"className":["heading-link-symbol"],"ariaHidden":"true"},"children":[]}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"text","value":"Some context, permissions, and configuration can carry between surfaces. The settings and context that apply depend on the Copilot feature and the surface you use."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"h3","properties":{"id":"customizations","tabIndex":-1},"children":[{"type":"element","tagName":"a","properties":{"className":["heading-link"],"href":"#customizations"},"children":[{"type":"text","value":"Customizations"},{"type":"element","tagName":"span","properties":{"className":["heading-link-symbol"],"ariaHidden":"true"},"children":[]}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"text","value":"Custom instructions let you save personal preferences for chat, repository conventions, and organization guidance."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"text","value":"Copilot Spaces organize shared context for questions."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"text","value":"For delegated work, custom agents and agent skills provide task-specific instructions and resources. Repository MCP servers connect agents to additional tools and data."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"p","properties":{},"children":[{"type":"text","value":"Hooks can run commands during agent work for validation or logging."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"h2","properties":{"id":"further-reading","tabIndex":-1},"children":[{"type":"element","tagName":"a","properties":{"className":["heading-link"],"href":"#further-reading"},"children":[{"type":"text","value":"Further reading"},{"type":"element","tagName":"span","properties":{"className":["heading-link-symbol"],"ariaHidden":"true"},"children":[]}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"ul","properties":{},"children":[{"type":"text","value":"\n"},{"type":"element","tagName":"li","properties":{},"children":[{"type":"element","tagName":"a","properties":{"href":"/en/copilot/how-tos/copilot-on-github"},"children":[{"type":"text","value":"GitHub Copilot on GitHub"}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"li","properties":{},"children":[{"type":"element","tagName":"a","properties":{"href":"/en/copilot/how-tos/use-copilot-agents/cloud-agent"},"children":[{"type":"text","value":"GitHub Copilot cloud agent"}]},{"type":"text","value":" how-to guides"}]},{"type":"text","value":"\n"},{"type":"element","tagName":"li","properties":{},"children":[{"type":"element","tagName":"a","properties":{"href":"/en/copilot/tutorials/copilot-cookbook"},"children":[{"type":"text","value":"GitHub Copilot Cookbook"}]}]},{"type":"text","value":"\n"},{"type":"element","tagName":"li","properties":{},"children":[{"type":"text","value":"For delegating work from tools such as Microsoft Teams and Slack, see "},{"type":"element","tagName":"a","properties":{"href":"/en/copilot/concepts/agent-capabilities/choosing-and-delegating-agent-work/about-copilot-integrations"},"children":[{"type":"text","value":"Copilot integrations"}]},{"type":"text","value":"."}]},{"type":"text","value":"\n"},{"type":"element","tagName":"li","properties":{},"children":[{"type":"text","value":"For organization and enterprise metrics on pull request creation, merges, and time to merge, see "},{"type":"element","tagName":"a","properties":{"href":"/en/copilot/concepts/billing-and-usage/copilot-usage-metrics/copilot-metrics"},"children":[{"type":"text","value":"GitHub Copilot usage metrics"}]},{"type":"text","value":"."}]},{"type":"text","value":"\n"}]}],"data":{"quirksMode":false}},"miniTocItems":[{"contents":{"href":"#how-copilot-helps-on-githubcom-and-github-mobile","title":"How Copilot helps on GitHub.com and GitHub Mobile"}},{"contents":{"href":"#key-concepts-for-copilot-in-the-cloud","title":"Key concepts for Copilot in the cloud"}},{"contents":{"href":"#access-and-availability","title":"Access and availability"}},{"contents":{"href":"#starting-with-copilot-on-githubcom-and-github-mobile","title":"Starting with Copilot on GitHub.com and GitHub Mobile"}},{"contents":{"href":"#ways-to-work-with-copilot","title":"Ways to work with Copilot"}},{"contents":{"href":"#session-history-and-remote-control","title":"Session history and remote control"}},{"contents":{"href":"#customize-your-experience","title":"Customize your experience"}},{"contents":{"href":"#copilot-limitations-and-compatibility","title":"Copilot limitations and compatibility"}},{"contents":{"href":"#the-older-experience","title":"The older experience"}},{"contents":{"href":"#further-reading","title":"Further reading"}}],"permissions":"","includesPlatformSpecificContent":false,"includesToolSpecificContent":false,"defaultPlatform":"","defaultTool":"","product":"","currentJourneyTrack":null,"detectedPlatforms":[],"detectedTools":[],"allTools":{"vscode":"Visual Studio Code","jetbrains":"JetBrains IDEs","visualstudio":"Visual Studio","cli":"GitHub CLI","webui":"Web browser","eclipse":"Eclipse","desktop":"Desktop","vimneovim":"Vim/Neovim","azure_data_studio":"Azure Data Studio","xcode":"Xcode","curl":"curl","javascript":"JavaScript","windowsterminal":"Windows Terminal","codespaces":"Codespaces","api":"API","mobile":"Mobile","copilotcli":"Copilot CLI","bash":"Bash","powershell":"PowerShell","skillsets":"Skillsets","agents":"Agents","jetbrains_beta":"JetBrains IDEs (Beta)","github_mobile":"GitHub Mobile","ides":"IDEs","importer_cli":"GitHub Enterprise Importer CLI"},"supportPortalVaIframeProps":{"supportPortalUrl":"https://support.github.com","vaFlowUrlParameter":""},"currentLayout":"def