from src.model import fail, validate, text, field
from src.render import overview, viewer, reading, print_deck, presenter
from src.locale import label

func option(argv, name, fallback) {
    i := 0
    while i < len(argv) {
        if argv[i] == name {
            if i + 1 >= len(argv) { fail("Missing value for " + name) }
            return argv[i + 1]
        }
        i = i + 1
    }
    return fallback
}
func run(command, cwd) {
    result := spawn_process(command, {"cwd": cwd, "inherit_env": true, "timeout_ms": 600000, "max_output_bytes": 2097152})
    if !result.success { fail(result.stdout + result.stderr) }
    return result.stdout
}
func copy_tree(source, target) {
    if path_is_symlink(source) { fail("Asset symlinks are not supported: " + source) }
    create_dir(target)
    for entry in list_dir(source) {
        from_path := source + "/" + entry
        to_path := target + "/" + entry
        if path_is_symlink(from_path) { fail("Asset symlinks are not supported: " + from_path) }
        if !path_is_dir(from_path) && !path_is_file(from_path) { fail("Asset must be a regular file or directory: " + from_path) }
        if path_is_dir(from_path) { copy_tree(from_path, to_path) } else { copy_file(from_path, to_path) }
    }
}
func page(stage, slug, title, html, deck, site_url) {
    # The public SSG post pipeline streams records; pages retain N full records.
    # Numeric slide routes use posts-at-root, without blog UI or article markup.
    kind := "pages"
    template := "page"
    if regex_replace(slug, "^[0-9]+$", "") == "" { kind = "posts"; template = "post" }
    # HTML stays in generated SSG templates, not Markdown raw-HTML parsing.
    write_file(stage + "/content/" + kind + "/" + slug + ".md", "---\ntitle: " + to_json(replace(replace(title, "\n", " "), "\r", " ")) + "\ntemplate: " + slug + "\nnav_hide: true\n---\n")
    write_file(stage + "/templates/" + template + "-" + slug + ".html", document_html(deck, title, html, "../", site_url + "/" + slug + "/"))
}
func document_html(deck, title, content, prefix, url) {
    description := deck["description"]
    slide_index := 1
    for slide in deck["slides"] {
        if ends_with(url, "/" + to_string(slide_index) + "/") { description = field(slide, "copy", slide["title"]); title = title + " — " + deck["title"] }
        slide_index = slide_index + 1
    }
    utility := ends_with(url, "/print/") || ends_with(url, "/presenter/") || len(url) == 0
    if ends_with(url, "/reading/") { description = "Read the complete presentation: " + deck["description"] }
    if ends_with(url, "/print/") { title = deck["title"] + " — Print"; description = "Printable slides for " + deck["title"] }
    if ends_with(url, "/presenter/") { title = deck["title"] + " — Presenter"; description = "Presenter controls for " + deck["title"] }
    if len(url) == 0 { description = "This page was not found. Open the presentation overview to choose a slide." }
    metadata := "<meta property=\"og:type\" content=\"website\"><meta property=\"og:title\" content=\"" + text(title) + "\"><meta property=\"og:description\" content=\"" + text(description) + "\"><meta name=\"twitter:card\" content=\"summary\">"
    if utility { metadata = metadata + "<meta name=\"robots\" content=\"noindex,follow\">" }
    if len(url) > 0 {
        metadata = metadata + "<meta property=\"og:url\" content=\"" + text(url) + "\">"
        data := to_json({"@context": "https://schema.org", "@type": "WebPage", "name": title, "description": description, "url": url, "inLanguage": field(deck, "lang", "en")})
        data = replace(replace(data, "<", "\\u003c"), "{{", "\\u007b\\u007b")
        metadata = metadata + "<script type=\"application/ld+json\">" + data + "</script>"
    }
    canonical := ""
    if len(url) > 0 { canonical = "<link rel=\"canonical\" href=\"" + text(url) + "\">" }
    return "<!doctype html><html lang=\"" + text(field(deck, "lang", "en")) + "\" dir=\"" + text(field(deck, "dir", "ltr")) + "\" data-theme=\"kujo-light\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>" + text(title) + "</title><meta name=\"description\" content=\"" + text(description) + "\">" + canonical + metadata + "<link rel=\"stylesheet\" href=\"" + prefix + "assets/sitekit/sitekit.css\"><link rel=\"stylesheet\" href=\"" + prefix + "assets/presentation/presentation.css\"><link rel=\"stylesheet\" href=\"" + prefix + "assets/deck/theme.css\"></head><body><a class=\"p-skip\" href=\"#main-content\">" + text(label(deck, "skip")) + "</a>" + content + "</body></html>"
}
export func build(argv) {
    arg_index := 0
    seen_options := []
    while arg_index < len(argv) {
        arg := argv[arg_index]
        if contains(seen_options, arg) { fail("Repeated option: " + arg) }
        seen_options = push(seen_options, arg)
        if arg == "--help" || arg == "--check" { arg_index = arg_index + 1; continue }
        if !contains(["--deck", "--ssg", "--sitekit", "--site-url"], arg) { fail("Unknown option: " + arg) }
        if arg_index + 1 >= len(argv) || starts_with(argv[arg_index + 1], "--") { fail("Missing value for " + arg) }
        arg_index = arg_index + 2
    }
    if contains(argv, "--help") {
        print("kujo run build.kujo -- [--deck examples/reference] [--ssg ../ssg] [--sitekit ../site-kit/dist] [--site-url https://example.com] [--check]")
        exit(0)
    }
    root := trim(run(["pwd"], "."))
    deck_dir := option(argv, "--deck", "examples/reference")
    deck := parse_json(read_file(deck_dir + "/deck.json"))
    validate(deck, deck_dir)
    check_assets(deck_dir + "/assets", 0)
    if contains(argv, "--check") { print("Valid deck: " + deck["id"]); exit(0) }
    ssg_default := ".deps/ssg"
    sitekit_default := ".deps/site-kit/dist"
    if !path_is_file(ssg_default + "/build.kujo") { ssg_default = "../ssg" }
    if !path_is_file(sitekit_default + "/sitekit.css") { sitekit_default = "../site-kit/dist" }
    ssg := option(argv, "--ssg", ssg_default)
    sitekit := option(argv, "--sitekit", sitekit_default)
    if !starts_with(ssg, "/") { ssg = root + "/" + ssg }
    if !path_is_file(ssg + "/build.kujo") || !path_is_file(sitekit + "/sitekit.css") { fail("Provide a Kujo SSG checkout and built SiteKit dist") }
    site_url := option(argv, "--site-url", "https://example.com")
    if regex_replace(site_url, "^https?://[^\\s/?#]+[^\\s?#]*$", "") != "" { fail("--site-url must be an HTTP(S) URL without query or fragment") }
    site_url = regex_replace(site_url, "/+$", "")
    stage := root + "/.build/" + deck["id"]
    # Only package-owned stage/output names derived from a validated slug are rebuilt.
    if path_exists(stage) { run(["rm", "-rf", "--", stage], root) }
    create_dir(stage + "/content/pages")
    create_dir(stage + "/content/posts")
    create_dir(stage + "/templates")
    copy_tree("assets", stage + "/assets/presentation")
    if field(field(deck, "transitions", {}), "enabled", false) {
        motion_dir := stage + "/assets/presentation/motion"
        create_dir(motion_dir)
        for name in ["motion-mini.js", "LICENSE.md", "LICENSE-framer-motion.md", "README.md"] {
            copy_file("vendor/motion/" + name, motion_dir + "/" + name)
        }
        hybrid := false
        for slide in deck["slides"] {
            override := field(slide, "transitions", {})
            effect := field(override, "effect", field(deck["transitions"], "effect", "fade"))
            if field(override, "enabled", true) && contains(["editorial", "focus", "kinetic"], effect) { hybrid = true }
        }
        if hybrid { copy_file("vendor/motion/motion-hybrid.js", motion_dir + "/motion-hybrid.js") }
    }
    copy_tree(sitekit, stage + "/assets/sitekit")
    copy_tree(deck_dir + "/assets", stage + "/assets/deck")
    # Offline SSG font fallback files; the presentation theme chooses its own typography.
    create_dir(stage + "/assets/fonts")
    for font in ["bree-serif-latin-400.woff2", "inter-latin-400.woff2", "inter-latin-700.woff2"] {
        copy_file(ssg + "/assets/fonts/" + font, stage + "/assets/fonts/" + font)
    }
    # Content is a complete escaped document; SSG still owns routes and assets.
    write_file(stage + "/templates/layout.html", "{{content}}")
    write_file(stage + "/templates/page-home.html", document_html(deck, deck["title"], overview(deck), "./", site_url + "/"))
    write_file(stage + "/templates/page-blog.html", document_html(deck, deck["title"], overview(deck), "./", site_url + "/"))
    write_file(stage + "/templates/404.html", document_html(deck, "Slide not found", "<main id=\"main-content\" class=\"p-reading sk-container\"><h1>Slide not found</h1><p>Open the deck overview to choose a slide.</p><a href=\"" + text(site_url) + "/\">Overview</a></main>", site_url + "/", ""))
    i := 1
    for slide in deck["slides"] { page(stage, to_string(i), slide["title"], viewer(deck, slide, i), deck, site_url); i = i + 1 }
    page(stage, "print", deck["title"], print_deck(deck), deck, site_url)
    page(stage, "presenter", deck["title"], presenter(deck), deck, site_url)
    page(stage, "reading", deck["title"] + " — Read text", reading(deck), deck, site_url)
    write_file(stage + "/kujo-ssg.json", to_json({"site_url": site_url, "site_title": deck["title"], "site_tagline": deck["description"], "content": "content", "templates": "templates", "assets": "assets", "output": stage + "/site", "fonts": ["Bree Serif", "Inter"], "webmcp": false, "minify": false, "no_aux": true, "posts_at_root": true, "posts_per_page": len(deck["slides"])}))
    print(run(["kujo", "run", "--interpreter", ssg + "/build.kujo", "--", "--no-aux", "--no-aliases", "--no-webmcp"], stage))
    # The SSG blog archive has no role in a deck; remove it before publication.
    run(["rm", "-rf", "--", stage + "/site/blog"], root)
    sitemap := "<?xml version=\"1.0\" encoding=\"UTF-8\"?><urlset xmlns=\"http://www.sitemaps.org/schemas/sitemap/0.9\"><url><loc>" + text(site_url) + "/</loc></url>"
    i = 1
    for slide in deck["slides"] { sitemap = sitemap + "<url><loc>" + text(site_url) + "/" + to_string(i) + "/</loc></url>"; i = i + 1 }
    sitemap = sitemap + "<url><loc>" + text(site_url) + "/reading/</loc></url></urlset>"
    write_file(stage + "/site/sitemap.xml", sitemap)
    write_file(stage + "/site/robots.txt", "User-agent: *\nDisallow:\nSitemap: " + site_url + "/sitemap.xml\n")

}

# Validate the whole deck asset tree, including unused files, before any build writes.
func check_assets(source, depth) {
    if path_is_symlink(source) { fail("Asset symlinks are not supported: " + source) }
    if depth > 16 { fail("Asset tree exceeds 16 directory levels: " + source) }
    if !path_is_dir(source) { fail("Asset directory missing: " + source) }
    for entry in list_dir(source) {
        path := source + "/" + entry
        if starts_with(entry, ".") { fail("Hidden assets cannot be published: " + path) }
        if path_is_symlink(path) { fail("Asset symlinks are not supported: " + path) }
        if path_is_dir(path) { check_assets(path, depth + 1) }
        else { if !path_is_file(path) { fail("Asset must be a regular file: " + path) } }
    }
}

export func main(argv) {
    # The child owns fallible generation. Its exit cannot bypass parent cleanup.
    if contains(argv, "--check") || contains(argv, "--help") { build(argv); return }
    deck_dir := option(argv, "--deck", "examples/reference")
    deck := parse_json(read_file(deck_dir + "/deck.json"))
    validate(deck, deck_dir)
    check_assets(deck_dir + "/assets", 0)
    root := trim(run(["pwd"], "."))
    id := deck["id"]
    create_dir(root + "/.build/.locks")
    create_dir(root + "/output")
    lock := root + "/.build/.locks/" + id
    command := ["kujo", "run", "src/build-worker.kujo"]
    if len(argv) > 0 { command = push(command, "--") }
    for arg in argv { command = push(command, arg) }
    acquired := spawn_process(["mkdir", lock], {"cwd": root, "inherit_env": true})
    if !acquired.success { fail("Build locked: " + lock + ". Stop any build for this ID before removing a stale lock.") }
    # The worker owns generation and publication; ordinary failures release the lock.
    result := spawn_process(command, {"cwd": root, "inherit_env": true, "timeout_ms": 1200000, "max_output_bytes": 2097152})
    if result.timed_out || result.exitcode < 0 { fail("Build worker interrupted or timed out; stop all child builds before removing lock: " + lock) }
    if !result.success && !path_exists(root + "/output/" + id) && path_exists(root + "/.build/" + id + ".previous") {
        rename_file(root + "/.build/" + id + ".previous", root + "/output/" + id)
    }
    run(["rmdir", lock], root)
    if !result.success { fail(result.stdout + result.stderr) }
    print(result.stdout)
    print("Presentation built: output/" + id + "/index.html")
}

export func publish(argv) {
    deck := parse_json(read_file(option(argv, "--deck", "examples/reference") + "/deck.json"))
    validate(deck, option(argv, "--deck", "examples/reference"))
    id := deck["id"]
    output := "output/" + id
    backup := ".build/" + id + ".previous"
    if (path_exists(output) && path_is_symlink(output)) || (path_exists(backup) && path_is_symlink(backup)) || (path_exists(".build/" + id) && path_is_symlink(".build/" + id)) { fail("Build paths must not be symlinks") }
    # Recover an interrupted swap before generation can fail or clear staging.
    if path_exists(backup) {
        if !path_exists(output) { rename_file(backup, output) }
        else { run(["rm", "-rf", "--", backup], ".") }
    }
    build(argv)
    if path_exists(output) { rename_file(output, backup) }
    # If interrupted here, the next locked build restores the previous output.
    swapped := spawn_process(["mv", "--", ".build/" + id + "/site", output], {"cwd": ".", "inherit_env": true})
    if !swapped.success {
        if path_exists(backup) { rename_file(backup, output) }
        fail("Could not publish deck: " + swapped.stderr)
    }
    if path_exists(backup) { run(["rm", "-rf", "--", backup], ".") }
}
