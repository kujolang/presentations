                "src": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 180,
                  "pattern": "^(?!/)(?!.*\\.\\.)[a-zA-Z0-9_/-]+\\.[a-zA-Z0-9]+$"
                },
                "alt": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                },
                "x": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
