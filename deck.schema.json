        },
        "duration": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 2
        },
        "easing": {
          "enum": [
            "linear",
            "easeIn",
            "easeOut",
            "easeInOut"
          ]
        },
        "intensity": {
          "type": "number",
          "minimum": 0.25,
          "maximum": 2
        },
        "stagger": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.2
        }
