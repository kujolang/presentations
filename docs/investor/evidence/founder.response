pe":"SoftwareSourceCode","@id":"https://github.com/robertdevore/strata#source","name":"Strata","codeRepository":"https://github.com/robertdevore/strata","creator":{"@id":"https://robertdevore.com/#person"}},{"@type":"SoftwareSourceCode","@id":"https://github.com/robertdevore/reporadar#source","name":"RepoRadar","codeRepository":"https://github.com/robertdevore/reporadar","creator":{"@id":"https://robertdevore.com/#person"}},{"@type":"SoftwareSourceCode","@id":"https://github.com/WebDevStudios/db-version-control#source","name":"DB Version Control","codeRepository":"https://github.com/WebDevStudios/db-version-control","creator":{"@id":"https://robertdevore.com/#person"}}]}</script><meta content="https://robertdevore.com/assets/social/about-social.png" property="og:image"/><meta content="image/png" property="og:image:type"/><meta content="1200" property="og:image:width"/><meta content="630" property="og:image:height"/><meta content="Robert DeVore — Software Engineer &amp; Security Researcher" property="og:image:alt"/><meta content="https://robertdevore.com/assets/social/about-social.png" name="twitter:image"/><meta content="Robert DeVore — Software Engineer &amp; Security Researcher" name="twitter:image:alt"/></head>
